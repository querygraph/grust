diff --git a/examples/extensions/nutmeg/src/tests.rs b/examples/extensions/nutmeg/src/tests.rs
index 647e93ada..468d6657e 100644
--- a/examples/extensions/nutmeg/src/tests.rs
+++ b/examples/extensions/nutmeg/src/tests.rs
@@ -1,4 +1,4 @@
-use arrow::array::{Array, ArrayRef, Int64Array, StringArray};
+use arrow::array::{Array, ArrayRef, BooleanArray, Int64Array, StringArray};
 use arrow::record_batch::RecordBatch;
 use datafusion::datasource::MemTable;
 use datafusion::physical_plan::collect;
@@ -370,3 +370,99 @@ async fn empty_inputs_validate_schema_and_mapping_before_mutation() {
     );
