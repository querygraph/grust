+
+async fn put(store: &ReverseListStore, path: &str, field: &str) -> Result<ObjectMeta> {
+    let path = Path::from(path);
+    store
+        .put(&path, Bytes::copy_from_slice(field.as_bytes()).into())
+        .await?;
+    let mut meta = store.head(&path).await?;
+    meta.version = Some(format!("listed:{path}"));
+    Ok(meta)
+}
+
+async fn create_source<R: ReadFormat + From<Arc<Observations>> + Default>(
+    context: &SessionContext,
+    paths: Vec<String>,
+) -> Result<Arc<dyn TableSource>> {
+    ListingDataSource::<InferenceFactory<R>>::default()
+        .create_source(
+            &context.state(),
+            SourceInfo {
+                paths,
+                lakehouse_table: None,
+                schema: None,
+                constraints: datafusion_common::Constraints::default(),
+                partition_by: vec![],
+                bucket_by: None,
+                sort_order: vec![],
+                options: vec![],
+                read_case_sensitive: true,
+            },
+        )
+        .await
+}
+
+#[tokio::test]
+async fn all_files_reach_schema_and_compression_inference_with_exact_identities() -> Result<()> {
+    let (context, store, observations) = fixture();
+    let mut expected = Vec::new();
+    for index in 0..11 {
+        expected.push(
+            put(
+                &store,
+                &format!("data/{index:02}.schema"),
+                if index == 0 { "extra" } else { "base" },
+            )
+            .await?,
+        );
+    }
+    for (path, field) in [
+        ("data/.hidden.schema", "hidden"),
+        ("data/_private/part.schema", "hidden_directory"),
+        ("data/_SUCCESS", "marker"),
+        ("data/ignored.other", "wrong_glob"),
+        ("data/empty.schema", ""),
+    ] {
+        put(&store, path, field).await?;
+    }
+    let paths = vec!["memory://inference/data/".to_string()];
+    let sampled = create_source::<SampleReadFormat>(&context, paths.clone()).await?;
+    assert_eq!(
+        sampled
+            .schema()
+            .fields()
+            .iter()
+            .map(|f| f.name().as_str())
+            .collect::<Vec<_>>(),
+        ["base"]
+    );
+    let sampled_objects = vec![expected.iter().rev().take(10).cloned().collect::<Vec<_>>()];
+    assert_eq!(*observations.schema.lock().unwrap(), sampled_objects);
+    assert_eq!(*observations.compression.lock().unwrap(), sampled_objects);
+
+    let all = create_source::<AllReadFormat>(&context, paths).await?;
+    assert_eq!(
+        all.schema()
+            .fields()
+            .iter()
+            .map(|f| f.name().as_str())
+            .collect::<Vec<_>>(),
+        ["base", "extra"]
+    );
+    assert_eq!(*observations.schema.lock().unwrap(), vec![expected.clone()]);
+    assert_eq!(
+        *observations.compression.lock().unwrap(),
+        vec![expected.clone()]
+    );
+
+    // The URL glob and the format's filename glob both remain active.
+    create_source::<AllReadFormat>(
+        &context,
+        vec!["memory://inference/data/0*.schema".to_string()],
+    )
+    .await?;
+    assert_eq!(
+        *observations.schema.lock().unwrap(),
+        vec![expected[..10].to_vec()]
+    );
+    assert_eq!(
+        *observations.compression.lock().unwrap(),
+        vec![expected[..10].to_vec()]
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn all_selection_retains_url_order_and_empty_groups() -> Result<()> {
+    let (context, store, observations) = fixture();
+    let z = put(&store, "z/part.schema", "z").await?;
+    let a = put(&store, "a/part.schema", "a").await?;
+    put(&store, "empty/zero.schema", "").await?;
+    let urls = ["z/", "a/", "empty/"]
+        .map(|path| ListingTableUrl::parse(format!("memory://inference/{path}")).unwrap());
+    let filter = PathGlobFilter::parse("*.schema").unwrap();
+    let state = context.state();
+    let selected =
+        select_listing_files(&state, &urls, Some(&filter), ListingFileSelection::All).await?;
+    assert_eq!(selected.len(), 3);
+    let expected = [vec![z], vec![a], vec![]];
+    let expected_store: Arc<dyn ObjectStore> = store;
+    for (index, group) in selected.iter().enumerate() {
+        assert_eq!(group.url, &urls[index]);
+        assert_eq!(group.objects, expected[index]);
+        assert!(Arc::ptr_eq(&group.store, &expected_store));
+    }
+    let empty =
+        create_source::<AllReadFormat>(&context, vec!["memory://inference/empty/".to_string()])
+            .await?;
+    assert!(empty.schema().fields().is_empty());
+    assert_eq!(
+        *observations.schema.lock().unwrap(),
+        vec![Vec::<ObjectMeta>::new()]
+    );
+    assert_eq!(
+        *observations.compression.lock().unwrap(),
+        vec![Vec::<ObjectMeta>::new()]
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn all_selection_checks_partition_layout_beyond_the_sample() -> Result<()> {
+    let (context, store, _) = fixture();
+    for index in 0..10 {
+        put(&store, &format!("partitions/b=1/{index:02}.schema"), "base").await?;
+    }
+    put(&store, "partitions/a=1/last.schema", "base").await?;
+    let paths = vec!["memory://inference/partitions/".to_string()];
+    let sampled = create_source::<SampleReadFormat>(&context, paths.clone()).await?;
+    assert_eq!(sampled.schema().field(1).name(), "b");
+    let error = match create_source::<AllReadFormat>(&context, paths).await {
+        Err(error) => error,
+        Ok(_) => return plan_err!("all-file inference missed the conflicting partition layout"),
+    };
+    assert!(
+        error.to_string().contains("mixed partition values"),
+        "{error}"
+    );
+    Ok(())
+}
