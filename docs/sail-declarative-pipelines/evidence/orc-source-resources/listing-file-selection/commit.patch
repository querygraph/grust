+    }
+
+    async fn scan(&self, ctx: &dyn Session, input: ListingScanInput) -> Result<FileScanConfig> {
+        self.0.scan(ctx, input).await
+    }
+
+    fn path_glob_filter(&self) -> Option<&str> {
+        self.0.path_glob_filter()
+    }
+}
