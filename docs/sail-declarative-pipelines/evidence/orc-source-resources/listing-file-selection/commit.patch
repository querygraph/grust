+/// Deliberately lists in reverse path order, with version metadata distinct
+/// from a fresh HEAD. Inference must retain the listed objects unchanged.
+#[derive(Debug, Default)]
+struct ReverseListStore(InMemory);
+
+impl fmt::Display for ReverseListStore {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "ReverseListStore")
+    }
+}
+
+#[async_trait]
+impl ObjectStore for ReverseListStore {
+    async fn put_opts(
+        &self,
+        path: &Path,
+        payload: PutPayload,
+        options: PutOptions,
+    ) -> object_store::Result<PutResult> {
+        self.0.put_opts(path, payload, options).await
+    }
+
+    async fn put_multipart_opts(
+        &self,
+        path: &Path,
+        options: PutMultipartOptions,
+    ) -> object_store::Result<Box<dyn MultipartUpload>> {
+        self.0.put_multipart_opts(path, options).await
+    }
+
+    async fn get_opts(&self, path: &Path, options: GetOptions) -> object_store::Result<GetResult> {
+        self.0.get_opts(path, options).await
+    }
+
+    fn delete_stream(
+        &self,
+        paths: BoxStream<'static, object_store::Result<Path>>,
+    ) -> BoxStream<'static, object_store::Result<Path>> {
+        self.0.delete_stream(paths)
+    }
+
+    fn list(&self, prefix: Option<&Path>) -> BoxStream<'static, object_store::Result<ObjectMeta>> {
+        let files = self.0.list(prefix);
+        stream::once(async move {
+            let mut files = files.try_collect::<Vec<_>>().await?;
+            files.reverse();
+            Ok::<_, object_store::Error>(stream::iter(files.into_iter().map(|mut meta| {
+                meta.version = Some(format!("listed:{}", meta.location));
+                Ok(meta)
+            })))
+        })
+        .try_flatten()
+        .boxed()
+    }
+
+    async fn list_with_delimiter(&self, prefix: Option<&Path>) -> object_store::Result<ListResult> {
+        self.0.list_with_delimiter(prefix).await
+    }
+
+    async fn copy_opts(
+        &self,
+        from: &Path,
+        to: &Path,
+        options: CopyOptions,
+    ) -> object_store::Result<()> {
+        self.0.copy_opts(from, to, options).await
+    }
+}
+
+#[derive(Debug, Default)]
+struct Observations {
+    compression: Mutex<Vec<Vec<ObjectMeta>>>,
+    schema: Mutex<Vec<Vec<ObjectMeta>>>,
+}
+
+#[derive(Debug, Default)]
+struct SampleReadFormat(Arc<Observations>);
+
+#[derive(Debug, Default)]
+struct AllReadFormat(SampleReadFormat);
+
+impl From<Arc<Observations>> for SampleReadFormat {
+    fn from(observations: Arc<Observations>) -> Self {
+        Self(observations)
+    }
+}
+
+impl From<Arc<Observations>> for AllReadFormat {
+    fn from(observations: Arc<Observations>) -> Self {
+        Self(SampleReadFormat(observations))
+    }
+}
+
+#[derive(Debug, Default)]
+struct InferenceFactory<R>(PhantomData<R>);
+
+impl<R: ReadFormat + From<Arc<Observations>> + Default> FormatFactory for InferenceFactory<R> {
+    type Read = R;
+    type Write = SampleReadFormat;
+
+    fn name() -> &'static str {
+        "inference_selection_test"
+    }
+
+    fn read(ctx: &dyn Session, _options: Vec<OptionLayer>) -> Result<Self::Read> {
+        Ok(ctx.config().get_extension::<Observations>().unwrap().into())
+    }
+
+    fn write(ctx: &dyn Session, _options: Vec<OptionLayer>) -> Result<Self::Write> {
+        Ok(ctx.config().get_extension::<Observations>().unwrap().into())
+    }
+}
+
+#[async_trait]
+impl ReadFormat for SampleReadFormat {
+    // Intentionally inherits ReadFormat's default file selection.
+    async fn infer_compression(
+        &self,
+        _ctx: &dyn Session,
+        files: &[ListingFileSample<'_>],
+    ) -> Result<CompressionTypeVariant> {
+        *self.0.compression.lock().unwrap() = files.iter().map(|g| g.objects.clone()).collect();
+        Ok(CompressionTypeVariant::UNCOMPRESSED)
+    }
+
+    async fn infer_schema(
+        &self,
+        _ctx: &dyn Session,
+        files: &[ListingFileSample<'_>],
+        _compression: CompressionTypeVariant,
+    ) -> Result<SchemaRef> {
+        *self.0.schema.lock().unwrap() = files.iter().map(|g| g.objects.clone()).collect();
+        let mut names = BTreeSet::new();
+        for group in files {
+            for object in &group.objects {
+                // Each test file contains the name of a field. Reading its
+                // bytes proves the eleventh object reaches the inference hook.
+                let bytes = group.store.get(&object.location).await?.bytes().await?;
+                names.insert(String::from_utf8(bytes.to_vec()).unwrap());
+            }
+        }
+        Ok(Arc::new(Schema::new(
+            names
+                .into_iter()
+                .map(|name| Field::new(name, DataType::Int64, true))
+                .collect::<Vec<_>>(),
+        )))
+    }
+
+    async fn scan(&self, _ctx: &dyn Session, _input: ListingScanInput) -> Result<FileScanConfig> {
+        plan_err!("test only exercises source inference")
+    }
+
+    fn path_glob_filter(&self) -> Option<&str> {
+        Some("*.schema")
+    }
+}
+
