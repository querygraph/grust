+
+/// Drop the buffer before releasing its reservation, including on sliced Bytes.
+struct ReservedRange {
+    buffer: Vec<u8>,
+    _reservation: MemoryReservation,
+}
+
+impl AsRef<[u8]> for ReservedRange {
+    fn as_ref(&self) -> &[u8] {
+        &self.buffer
     }
