+struct Lz4;
+
+fn read_bounded_block(reader: impl Read, scratch: &mut Vec<u8>, limit: usize) -> Result<()> {
+    scratch.clear();
+    // Read at most one byte beyond the declared size to distinguish exact EOF
+    // from an oversized block without allocating the entire decoded payload.
+    reader
+        .take(limit as u64 + 1)
+        .read_to_end(scratch)
+        .context(error::IoSnafu)?;
+    ensure!(
+        scratch.len() <= limit,
+        error::OutOfSpecSnafu {
+            msg: "Decoded compression block exceeds the declared block size"
+        }
+    );
+    Ok(())
 }
 
 impl DecompressorVariant for Zlib {
-    fn decompress_block(&self, compressed_bytes: &[u8], scratch: &mut Vec<u8>) -> Result<()> {
-        let mut gz = flate2::read::DeflateDecoder::new(compressed_bytes);
-        scratch.clear();
-        gz.read_to_end(scratch).context(error::IoSnafu)?;
-        Ok(())
+    fn decompress_block(&self, bytes: &[u8], scratch: &mut Vec<u8>, limit: usize) -> Result<()> {
+        read_bounded_block(flate2::read::DeflateDecoder::new(bytes), scratch, limit)
     }
 }
 
 impl DecompressorVariant for Zstd {
-    fn decompress_block(&self, compressed_bytes: &[u8], scratch: &mut Vec<u8>) -> Result<()> {
-        let mut reader =
-            zstd::Decoder::new(compressed_bytes).context(error::BuildZstdDecoderSnafu)?;
-        scratch.clear();
-        reader.read_to_end(scratch).context(error::IoSnafu)?;
-        Ok(())
+    fn decompress_block(&self, bytes: &[u8], scratch: &mut Vec<u8>, limit: usize) -> Result<()> {
+        let mut reader = zstd::Decoder::new(bytes).context(error::BuildZstdDecoderSnafu)?;
+        // ORC blocks are independent and smaller than 2^23 bytes. Bound the
+        // decoder's history allocation as well as its output buffer.
+        reader.window_log_max(23).context(error::IoSnafu)?;
+        read_bounded_block(reader, scratch, limit)
     }
 }
 
