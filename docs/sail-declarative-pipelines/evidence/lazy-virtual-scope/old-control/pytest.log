        namespace = f"{pipeline_spark.catalog.currentCatalog()}.{pipeline_spark.catalog.currentDatabase()}"
        expected = []
        if read and not declared:
            expected.append(f"{namespace}.consumer")
        if missing != "none":
            expected.append(f"{namespace}.late")
