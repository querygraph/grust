CASE a STRUCT<s: VARCHAR(5), n: SMALLINT> || a STRUCT<s: CHAR(5), n: INT>
  PARAMS {left="STRUCT<s: VARCHAR(5), n: SMALLINT>", right="STRUCT<s: CHAR(5), n: INT>"}
CASE a ARRAY<SMALLINT> || a ARRAY<INT>
  PARAMS {left="ARRAY<SMALLINT>", right="ARRAY<INT>"}
CASE a MAP<VARCHAR(3), SMALLINT> || a MAP<VARCHAR(3), STRING>
  PARAMS {left="MAP<VARCHAR(3), SMALLINT>", right="MAP<VARCHAR(3), STRING>"}
CASE a STRUCT<`1abc`: INT> || a STRUCT<`1abc`: STRING>
  PARAMS {left="STRUCT<`1abc`: INT>", right="STRUCT<`1abc`: STRING>"}
CASE a STRUCT<`x y`: INT NOT NULL, `z``q`: INT> || a STRUCT<`x y`: STRING>
  PARAMS {left="STRUCT<`x y`: INT NOT NULL, `z``q`: INT>", right="STRUCT<`x y`: STRING>"}
CASE a STRUCT<`123`: INT> || a STRUCT<`123`: STRING>
  PARAMS {left="STRUCT<`123`: INT>", right="STRUCT<`123`: STRING>"}
CASE v VOID || v INT
  PARAMS {left="VOID", right="INT"}
CASE v INT || v VOID
  PARAMS {left="INT", right="VOID"}
CASE ts TIMESTAMP_NTZ || ts TIMESTAMP
  PARAMS {left="TIMESTAMP_NTZ", right="TIMESTAMP"}
CASE i INTERVAL YEAR TO MONTH || i INTERVAL DAY
  PARAMS {left="INTERVAL YEAR TO MONTH", right="INTERVAL DAY"}
CASE i INTERVAL YEAR TO MONTH || i STRING
  PARAMS {left="INTERVAL YEAR TO MONTH", right="STRING"}
CASE i INTERVAL DAY TO SECOND || i STRING
  PARAMS {left="INTERVAL DAY TO SECOND", right="STRING"}
CASE i INTERVAL MONTH || i STRING
  PARAMS {left="INTERVAL MONTH", right="STRING"}
CASE i INTERVAL HOUR TO MINUTE || i STRING
  PARAMS {left="INTERVAL HOUR TO MINUTE", right="STRING"}
CASE t TIME || t TIME(6)
  OK t TIME(6)
CASE t TIME || t STRING
  PARAMS {left="TIME(6)", right="STRING"}
CASE d DECIMAL || d DECIMAL(10,0)
  OK d DECIMAL(10,0)
CASE d DECIMAL || d STRING
  PARAMS {left="DECIMAL(10,0)", right="STRING"}
CASE b TINYINT || b SMALLINT
  PARAMS {left="TINYINT", right="SMALLINT"}
CASE s VARCHAR(5) || s VARCHAR(6)
  PARAMS {left="VARCHAR(5)", right="VARCHAR(6)"}
CASE s CHAR(5) || s CHAR(5)
  OK s CHAR(5)
CASE s CHAR(5) || s VARCHAR(5)
  PARAMS {left="CHAR(5)", right="VARCHAR(5)"}
CASE a ARRAY<INT> || a STRING
  PARAMS {left="ARRAY<INT>", right="STRING"}
CASE a MAP<INT, INT> || a ARRAY<INT>
  PARAMS {left="MAP<INT, INT>", right="ARRAY<INT>"}
CASE a STRUCT<x: INT> || a INT
  PARAMS {left="STRUCT<x: INT>", right="INT"}
