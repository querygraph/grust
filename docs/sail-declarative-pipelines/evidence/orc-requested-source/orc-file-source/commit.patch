+
+fn metadata(file: &Bytes) -> FileMetadata {
+    read_metadata_with_options(
+        &mut file.clone(),
+        options()
+            .resource_limits(&datafusion::execution::memory_pool::UnboundedMemoryPool::default())
+            .metadata_options(),
+    )
+    .unwrap()
+}
