      "sql": "\nCREATE MATERIALIZED VIEW mv USING parquet AS SELECT * FROM RANGE(3);\nUSE DATABASE `sdp_scope_803340f6f93e4b08bae3d456e8c72c30_other`;\nCREATE MATERIALIZED VIEW mv2 USING parquet AS SELECT * FROM RANGE(1, 5);\nCREATE MATERIALIZED VIEW mv3 USING parquet AS\nWITH mv AS (SELECT * FROM `primary`.`sdp_scope_803340f6f93e4b08bae3d456e8c72c30_pipeline`.mv)\nSELECT mv2.id FROM mv JOIN mv2 ON mv.id=mv2.id;\nSET CATALOG `lakecat`;\nUSE DATABASE `sdp_scope_803340f6f93e4b08bae3d456e8c72c30_secondary`;\nCREATE TEMPORARY VIEW tv AS SELECT * FROM `primary`.`sdp_scope_803340f6f93e4b08bae3d456e8c72c30_pipeline`.mv;\nCREATE MATERIALIZED VIEW mv4 USING iceberg AS\nWITH mv2 AS (SELECT * FROM `primary`.`sdp_scope_803340f6f93e4b08bae3d456e8c72c30_other`.mv2)\nSELECT * FROM STREAM(mv2) WHERE mv2.id % 2 == 0;\nUSE NAMESPACE `primary`.`sdp_scope_803340f6f93e4b08bae3d456e8c72c30_other`;\nCREATE MATERIALIZED VIEW mv5 USING parquet AS SELECT * FROM mv2;\nCREATE MATERIALIZED VIEW mv6 USING parquet AS SELECT * FROM tv;\n"
