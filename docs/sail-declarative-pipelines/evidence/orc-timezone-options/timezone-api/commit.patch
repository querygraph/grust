+pub(crate) fn decode_nanos(base: i64, encoded_seconds: i64, encoded_nanos: i64) -> Result<i128> {
+    let encoded_nanos = u64::try_from(encoded_nanos).map_err(|_| invalid("negative nanos"))?;
