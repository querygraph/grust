+use std::sync::{Arc, Mutex};
+
+use arrow::{
+    array::{Array, RecordBatch, TimestampMicrosecondArray},
+    datatypes::{Field, Schema},
+};
+use bytes::Bytes;
+use orc_rust::{
+    error::{OutOfSpecSnafu, Result},
+    proto, ArrowWriterBuilder, TimestampTimeZone, TimestampTimeZoneOptions,
+    TimestampTimeZoneResolver,
+};
+use prost::Message;
+
+pub const INPUT: i64 = 1_593_561_600_000_000;
+pub const HOUR: i64 = 3_600_000_000;
+
+#[derive(Debug)]
+pub struct Fixed(pub i32);
+
+impl TimestampTimeZone for Fixed {
+    fn orc_epoch_seconds(&self) -> i64 {
+        1_420_070_400 - i64::from(self.0) / 1000
+    }
+
+    fn offset_millis(&self, _: i64) -> Result<i32> {
+        Ok(self.0)
+    }
+}
+
+#[derive(Debug)]
+struct Summer;
+
+impl TimestampTimeZone for Summer {
+    fn orc_epoch_seconds(&self) -> i64 {
+        1_420_099_200
+    }
+
+    fn offset_millis(&self, millis: i64) -> Result<i32> {
+        Ok(
+            if (1_583_661_600_000..1_604_221_200_000).contains(&millis) {
+                -25_200_000
+            } else {
+                -28_800_000
+            },
+        )
+    }
+}
+
+#[derive(Debug, Default)]
+pub struct Resolver(pub Mutex<Vec<String>>);
+
+impl TimestampTimeZoneResolver for Resolver {
+    fn resolve(&self, name: &str) -> Result<Arc<dyn TimestampTimeZone>> {
+        self.0.lock().unwrap().push(name.to_owned());
+        match name {
+            "Custom/Summer" => Ok(Arc::new(Summer)),
+            "UTC" => Ok(Arc::new(Fixed(0))),
+            _ => Err(OutOfSpecSnafu {
+                msg: format!("unknown test writer timezone: {name}"),
+            }
+            .build()),
+        }
+    }
+}
+
+pub fn options() -> (TimestampTimeZoneOptions, Arc<Resolver>) {
+    let resolver = Arc::new(Resolver::default());
+    (
+        TimestampTimeZoneOptions::new(Arc::new(Fixed(0)), resolver.clone()),
+        resolver,
+    )
+}
+
+pub fn values(batches: &[RecordBatch]) -> Vec<Option<i64>> {
+    batches
+        .iter()
+        .flat_map(|batch| {
+            batch
+                .column(0)
+                .as_any()
+                .downcast_ref::<TimestampMicrosecondArray>()
+                .unwrap()
+                .iter()
+                .collect::<Vec<_>>()
+        })
+        .collect()
+}
+
+/// Native-written data with deliberately varied stripe names and real row-index
+/// statistics. Rebuild footer offsets after changing lengths; no binary fixtures
+/// or external writer are required to exercise reader state and pruning.
+pub fn file(names: &[Option<&str>], instant: bool) -> Bytes {
+    let array = TimestampMicrosecondArray::from(vec![Some(INPUT), None])
+        .with_timezone_opt(instant.then_some("UTC"));
+    let schema = Arc::new(Schema::new(vec![Field::new(
+        "ts",
+        array.data_type().clone(),
+        true,
+    )]));
+    let batch = RecordBatch::try_new(schema.clone(), vec![Arc::new(array)]).unwrap();
+    let mut encoded = Vec::new();
+    let mut writer = ArrowWriterBuilder::new(&mut encoded, schema)
+        .try_build()
+        .unwrap();
+    for _ in names {
+        writer.write(&batch).unwrap();
+        writer.flush_stripe().unwrap();
+    }
+    writer.close().unwrap();
+
+    let ps_len = usize::from(*encoded.last().unwrap());
+    let ps_start = encoded.len() - ps_len - 1;
+    let mut ps = proto::PostScript::decode(&encoded[ps_start..ps_start + ps_len]).unwrap();
+    assert_eq!(ps.compression(), proto::CompressionKind::None);
+    let footer_start = ps_start - ps.footer_length() as usize;
+    let metadata_start = footer_start - ps.metadata_length() as usize;
+    let mut footer = proto::Footer::decode(&encoded[footer_start..ps_start]).unwrap();
+    assert_eq!(footer.stripes.len(), names.len());
+    let row_index = proto::RowIndex {
+        entry: vec![proto::RowIndexEntry {
+            positions: vec![],
+            statistics: Some(proto::ColumnStatistics {
+                number_of_values: Some(1),
+                has_null: Some(true),
+                timestamp_statistics: Some(proto::TimestampStatistics {
+                    minimum_utc: Some(INPUT / 1000),
+                    maximum_utc: Some(INPUT / 1000),
+                    ..Default::default()
+                }),
+                ..Default::default()
+            }),
+        }],
+    }
+    .encode_to_vec();
+    let mut out = b"ORC".to_vec();
+    for (stripe, name) in footer.stripes.iter_mut().zip(names) {
+        assert_eq!(stripe.index_length(), 0);
+        let old_start = stripe.offset() as usize;
+        let old_footer = old_start + stripe.data_length() as usize;
+        let mut stripe_footer = proto::StripeFooter::decode(
+            &encoded[old_footer..old_footer + stripe.footer_length() as usize],
+        )
+        .unwrap();
+        stripe_footer.writer_timezone = name.map(str::to_owned);
+        stripe_footer.streams.insert(
+            0,
+            proto::Stream {
+                kind: Some(proto::stream::Kind::RowIndex as i32),
+                column: Some(1),
+                length: Some(row_index.len() as u64),
+            },
+        );
+        stripe.offset = Some(out.len() as u64);
+        stripe.index_length = Some(row_index.len() as u64);
+        out.extend_from_slice(&row_index);
+        out.extend_from_slice(&encoded[old_start..old_footer]);
+        let stripe_footer = stripe_footer.encode_to_vec();
+        stripe.footer_length = Some(stripe_footer.len() as u64);
+        out.extend_from_slice(&stripe_footer);
+    }
+    footer.content_length = Some(out.len() as u64);
+    footer.row_index_stride = Some(10_000);
+    out.extend_from_slice(&encoded[metadata_start..footer_start]);
+    let footer = footer.encode_to_vec();
+    ps.footer_length = Some(footer.len() as u64);
+    out.extend_from_slice(&footer);
+    let ps = ps.encode_to_vec();
+    out.extend_from_slice(&ps);
+    out.push(u8::try_from(ps.len()).unwrap());
+    Bytes::from(out)
+}
