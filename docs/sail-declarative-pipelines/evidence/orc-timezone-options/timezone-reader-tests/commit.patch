+use std::sync::Arc;
+
+use arrow::datatypes::{DataType, Field, Schema, TimeUnit};
+use orc_rust::{
+    ArrowReaderBuilder, Predicate, PredicateValue, RowSelector, TimestampPrecision,
+    TimestampTimeZoneOptions,
+};
+
+#[path = "support/timestamp_timezone.rs"]
+mod support;
+use support::{file, options, values, Fixed, Resolver, HOUR, INPUT};
+
+const NAMES: &[Option<&str>] = &[Some("Custom/Summer"), None, Some(""), Some("UTC"), None];
+
+#[test]
+fn writer_names_bypass_chrono_and_missing_names_inherit_per_reader() {
+    let (options, resolver) = options();
+    let builder = ArrowReaderBuilder::try_new(file(NAMES, false))
+        .unwrap()
+        .with_timestamp_precision(TimestampPrecision::Microsecond)
+        .with_timestamp_time_zone_options(options);
+    assert_eq!(
+        builder.schema().field(0).data_type(),
+        &DataType::Timestamp(TimeUnit::Microsecond, Some("UTC".into()))
+    );
+    let batches = builder.build().collect::<Result<Vec<_>, _>>().unwrap();
+    assert_eq!(
+        values(&batches),
+        vec![
+            Some(INPUT + HOUR),
+            None,
+            Some(INPUT + HOUR),
+            None,
+            Some(INPUT + HOUR),
+            None,
+            Some(INPUT),
+            None,
+            Some(INPUT),
+            None,
+        ]
+    );
+    assert_eq!(*resolver.0.lock().unwrap(), ["Custom/Summer", "UTC"]);
+}
+
+#[test]
+fn byte_range_start_does_not_inherit_unread_stripes() {
+    let (options, resolver) = options();
+    let builder = ArrowReaderBuilder::try_new(file(NAMES, false)).unwrap();
+    let start = builder.file_metadata().stripe_metadatas()[1].offset() as usize;
+    let batches = builder
+        .with_file_byte_range(start..usize::MAX)
+        .with_timestamp_precision(TimestampPrecision::Microsecond)
+        .with_timestamp_time_zone_options(options)
+        .build()
+        .collect::<Result<Vec<_>, _>>()
+        .unwrap();
+    assert_eq!(values(&batches), [Some(INPUT), None].repeat(4));
+    assert_eq!(*resolver.0.lock().unwrap(), ["UTC"]);
+}
+
+#[test]
+fn wholly_skipped_stripes_do_not_change_writer_timezone() {
+    let (options, resolver) = options();
+    let batches = ArrowReaderBuilder::try_new(file(NAMES, false))
+        .unwrap()
+        .with_timestamp_precision(TimestampPrecision::Microsecond)
+        .with_timestamp_time_zone_options(options)
+        .with_row_selection(vec![RowSelector::skip(2), RowSelector::select(8)].into())
+        .build()
+        .collect::<Result<Vec<_>, _>>()
+        .unwrap();
+    assert_eq!(values(&batches), [Some(INPUT), None].repeat(4));
+    assert_eq!(*resolver.0.lock().unwrap(), ["UTC"]);
+}
+
+#[test]
+fn output_timezone_is_a_label_and_instant_columns_do_not_resolve_writer_names() {
+    let (options, _) = options();
+    let schema = Arc::new(Schema::new(vec![Field::new(
+        "ts",
+        DataType::Timestamp(TimeUnit::Microsecond, Some("Asia/Kathmandu".into())),
+        true,
+    )]));
+    let batches = ArrowReaderBuilder::try_new(file(&[Some("Custom/Summer")], false))
+        .unwrap()
+        .with_schema(schema.clone())
+        .with_timestamp_time_zone_options(options)
+        .build()
+        .collect::<Result<Vec<_>, _>>()
+        .unwrap();
+    assert_eq!(values(&batches), vec![Some(INPUT + HOUR), None]);
+    assert_eq!(batches[0].schema(), schema);
+
+    let (options, resolver) = support::options();
+    let batches = ArrowReaderBuilder::try_new(file(&[Some("unrecognized")], true))
+        .unwrap()
+        .with_timestamp_precision(TimestampPrecision::Microsecond)
+        .with_timestamp_time_zone_options(options)
+        .build()
+        .collect::<Result<Vec<_>, _>>()
+        .unwrap();
+    assert_eq!(values(&batches), vec![Some(INPUT), None]);
+    assert!(resolver.0.lock().unwrap().is_empty());
+}
+
+#[test]
+fn resolver_failure_is_reported_without_a_metadata_parse_panic() {
+    let (options, _) = options();
+    let error = ArrowReaderBuilder::try_new(file(&[Some("unrecognized")], false))
+        .unwrap()
+        .with_timestamp_time_zone_options(options)
+        .build()
+        .next()
+        .unwrap()
+        .unwrap_err();
+    assert!(error
+        .to_string()
+        .contains("unknown test writer timezone: unrecognized"));
+}
+
+#[test]
+fn opt_in_disables_unsafe_statistics_pruning_but_keeps_manual_selection() {
+    let encoded = file(&[Some("UTC")], false);
+    let predicate = Predicate::eq("ts", PredicateValue::Int64(Some((INPUT + HOUR) / 1000)));
+    let default_builder = ArrowReaderBuilder::try_new(encoded.clone())
+        .unwrap()
+        .with_timestamp_precision(TimestampPrecision::Microsecond)
+        .with_predicate(predicate.clone());
+    assert_eq!(
+        default_builder.schema().field(0).data_type(),
+        &DataType::Timestamp(TimeUnit::Microsecond, None)
+    );
+    let default = default_builder
+        .build()
+        .collect::<Result<Vec<_>, _>>()
+        .unwrap();
+    assert!(values(&default).is_empty());
+    let options =
+        TimestampTimeZoneOptions::new(Arc::new(Fixed(-3_600_000)), Arc::new(Resolver::default()));
+    let batches = ArrowReaderBuilder::try_new(encoded)
+        .unwrap()
+        .with_timestamp_precision(TimestampPrecision::Microsecond)
+        .with_timestamp_time_zone_options(options)
+        .with_predicate(predicate)
+        .with_row_selection(vec![RowSelector::select(1), RowSelector::skip(1)].into())
+        .build()
+        .collect::<Result<Vec<_>, _>>()
+        .unwrap();
+    assert_eq!(values(&batches), vec![Some(INPUT + HOUR)]);
+}
+
+#[cfg(feature = "async")]
+#[tokio::test]
+async fn async_conversion_disables_statistics_pruning_and_keeps_manual_selection() {
+    use futures::TryStreamExt;
+    let options =
+        TimestampTimeZoneOptions::new(Arc::new(Fixed(-3_600_000)), Arc::new(Resolver::default()));
+    let batches =
+        ArrowReaderBuilder::try_new_async(std::io::Cursor::new(file(&[Some("UTC")], false)))
+            .await
+            .unwrap()
+            .with_timestamp_precision(TimestampPrecision::Microsecond)
+            .with_timestamp_time_zone_options(options)
+            .with_predicate(Predicate::eq(
+                "ts",
+                PredicateValue::Int64(Some((INPUT + HOUR) / 1000)),
+            ))
+            .with_row_selection(vec![RowSelector::select(1), RowSelector::skip(1)].into())
+            .build_async()
+            .try_collect::<Vec<_>>()
+            .await
+            .unwrap();
+    assert_eq!(values(&batches), vec![Some(INPUT + HOUR)]);
+}
+
+#[cfg(feature = "async")]
+#[tokio::test]
+async fn async_inheritance_range_starts_and_skipped_stripes_match_sync() {
+    use futures::TryStreamExt;
+    for mode in 0..3 {
+        let (options, resolver) = options();
+        let encoded = file(NAMES, false);
+        let mut builder = ArrowReaderBuilder::try_new_async(std::io::Cursor::new(encoded))
+            .await
+            .unwrap()
+            .with_timestamp_precision(TimestampPrecision::Microsecond)
+            .with_timestamp_time_zone_options(options);
+        if mode == 1 {
+            let start = builder.file_metadata().stripe_metadatas()[1].offset() as usize;
+            builder = builder.with_file_byte_range(start..usize::MAX);
+        } else if mode == 2 {
+            builder = builder
+                .with_row_selection(vec![RowSelector::skip(2), RowSelector::select(8)].into());
+        }
+        let batches = builder.build_async().try_collect::<Vec<_>>().await.unwrap();
+        if mode == 0 {
+            assert_eq!(
+                values(&batches),
+                vec![
+                    Some(INPUT + HOUR),
+                    None,
+                    Some(INPUT + HOUR),
+                    None,
+                    Some(INPUT + HOUR),
+                    None,
+                    Some(INPUT),
+                    None,
+                    Some(INPUT),
+                    None,
+                ]
+            );
+            assert_eq!(*resolver.0.lock().unwrap(), ["Custom/Summer", "UTC"]);
+        } else {
+            assert_eq!(values(&batches), [Some(INPUT), None].repeat(4));
+            assert_eq!(*resolver.0.lock().unwrap(), ["UTC"]);
+        }
+    }
+}
