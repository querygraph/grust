@@ -59,3 +59,76 @@ def test_pipeline_groupby_and_rollup(pipeline_spark, pipeline, tmp_path):
     total = rollup.where("id IS NULL").collect()
     assert len(total) == 1
     assert total[0].sum_id == total[0].cnt == 3
+
