      "path": "file1.sql",
      "sql": "\nCREATE MATERIALIZED VIEW mv USING parquet AS SELECT * FROM RANGE(3);\nUSE DATABASE `sdp_scope_5046302d0fbf4e0eb1dada860de75de2_other`;\nCREATE MATERIALIZED VIEW mv2 USING parquet AS SELECT * FROM RANGE(1, 5);\nCREATE MATERIALIZED VIEW mv3 USING parquet AS\nWITH mv AS (SELECT * FROM `spark_catalog`.`sdp_scope_5046302d0fbf4e0eb1dada860de75de2_pipeline`.mv)\nSELECT mv2.id FROM mv JOIN mv2 ON mv.id=mv2.id;\nSET CATALOG `c_bb3e5598_be3c_4250_a3e1_92c2a75bd3ce`;\nUSE DATABASE `sdp_scope_5046302d0fbf4e0eb1dada860de75de2_secondary`;\nCREATE TEMPORARY VIEW tv AS SELECT * FROM `spark_catalog`.`sdp_scope_5046302d0fbf4e0eb1dada860de75de2_pipeline`.mv;\nCREATE MATERIALIZED VIEW mv4 USING parquet AS\nWITH mv2 AS (SELECT * FROM `spark_catalog`.`sdp_scope_5046302d0fbf4e0eb1dada860de75de2_other`.mv2)\nSELECT * FROM STREAM(mv2) WHERE mv2.id % 2 == 0;\nUSE NAMESPACE `spark_catalog`.`sdp_scope_5046302d0fbf4e0eb1dada860de75de2_other`;\nCREATE MATERIALIZED VIEW mv5 USING parquet AS SELECT * FROM mv2;\nCREATE MATERIALIZED VIEW mv6 USING parquet AS SELECT * FROM tv;\n"
