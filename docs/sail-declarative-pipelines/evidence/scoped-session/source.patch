+use arrow::array::{BooleanArray, RecordBatch};
+use arrow::datatypes::{DataType, Field, Schema, SchemaRef};
+use datafusion::datasource::{MemTable, TableProvider, provider_as_source};
+use datafusion::execution::SessionStateBuilder;
+use datafusion::execution::context::QueryPlanner;
+use datafusion::execution::object_store::{DefaultObjectStoreRegistry, ObjectStoreUrl};
+// Exercise the existing native prepared-statement path without enabling SQL parsing.
+#[expect(clippy::disallowed_types)]
+use datafusion::logical_expr::Statement;
+use datafusion::logical_expr::{
+    ColumnarValue, Execute, LogicalPlanBuilder, Prepare, ScalarFunctionArgs, ScalarUDFImpl,
+    Signature, TableType, Volatility, lit,
+};
+use datafusion::physical_plan::collect;
+use datafusion::physical_planner::{DefaultPhysicalPlanner, PhysicalPlanner};
+use datafusion::prelude::SessionContext;
+use datafusion_common::ScalarValue;
+use datafusion_common::config::ConfigOptions;
+use object_store::ObjectStoreExt;
+use object_store::memory::InMemory;
+use object_store::path::Path;
+use tokio::runtime::Handle;
+
+use super::*;
+use crate::extension::SessionExtensionAccessor;
+
+type TestResult = std::result::Result<(), Box<dyn std::error::Error>>;
+
+#[derive(Debug, PartialEq, Eq, Hash)]
+struct ConfigUdf(Signature, bool);
+impl ConfigUdf {
+    fn new(flag: bool) -> Self {
+        Self(Signature::exact(vec![], Volatility::Immutable), flag)
+    }
+}
+impl ScalarUDFImpl for ConfigUdf {
+    fn name(&self) -> &str {
+        "scoped_config_probe"
+    }
+    fn signature(&self) -> &Signature {
+        &self.0
+    }
+    fn return_type(&self, _: &[DataType]) -> Result<DataType> {
+        Ok(DataType::Boolean)
+    }
+    fn invoke_with_args(&self, _: ScalarFunctionArgs) -> Result<ColumnarValue> {
+        Ok(ColumnarValue::Scalar(ScalarValue::Boolean(Some(self.1))))
+    }
+    fn with_updated_config(&self, config: &ConfigOptions) -> Option<ScalarUDF> {
+        Some(ScalarUDF::from(Self::new(
+            config.catalog.create_default_catalog_and_schema,
+        )))
+    }
+}
+
+#[tokio::test]
+async fn preserves_config_sensitive_udf_without_rebinding() -> TestResult {
+    let parent = SessionContext::new();
+    parent.register_udf(ScalarUDF::from(ConfigUdf::new(true)));
+    let before = parent.state();
+    let original = before.scalar_functions()["scoped_config_probe"].clone();
+    let resources = Arc::new(TaskResourceScope::new(Handle::current()));
+    let scoped = ScopedSession::new(before.clone(), resources.clone());
+    assert!(Arc::ptr_eq(
+        &original,
+        &scoped.scalar_functions()["scoped_config_probe"]
+    ));
+    assert!(scoped.config().create_default_catalog_and_schema());
+    assert_eq!(scoped.session_id(), parent.session_id());
+    assert!(Arc::ptr_eq(
+        &scoped.catalog_list(),
+        &Session::catalog_list(&before)
+    ));
+    assert_eq!(
+        scoped.execution_props().query_execution_start_time,
+        before.execution_props().query_execution_start_time
+    );
+    let logical = LogicalPlanBuilder::empty(true)
+        .project(vec![original.call(vec![])])?
+        .build()?;
+    let batches = collect(
+        scoped.create_physical_plan(&logical).await?,
+        scoped.task_ctx(),
+    )
+    .await?;
+    assert_eq!(
+        ScalarValue::try_from_array(batches[0].column(0).as_ref(), 0)?,
+        ScalarValue::Boolean(Some(true))
+    );
+    assert!(parent.extension::<TaskResourceScope>().is_err());
+    assert!(Arc::ptr_eq(
+        &scoped.task_ctx().extension::<TaskResourceScope>()?,
+        &resources
+    ));
+    assert!(scoped.as_any().downcast_ref::<ScopedSession>().is_some());
+    assert!(scoped.as_any().downcast_ref::<SessionState>().is_none());
+    resources.drain().await?;
+    Ok(())
+}
+
+#[tokio::test]
+async fn preserves_native_prepared_plan_registry() -> TestResult {
+    let parent = SessionContext::new();
+    parent
+        .execute_logical_plan(LogicalPlan::Statement(Statement::Prepare(Prepare {
+            name: "scoped_prepared".into(),
+            fields: vec![],
+            input: Arc::new(
+                LogicalPlanBuilder::empty(true)
+                    .project(vec![lit(7i32)])?
+                    .build()?,
+            ),
+        })))
+        .await?;
+    let resources = Arc::new(TaskResourceScope::new(Handle::current()));
+    let scoped = ScopedSession::new(parent.state(), resources.clone());
+    // Test-only native command dispatch proves the private captured state kept
+    // the prepared registry. Production commands retain the authoritative ctx.
+    let captured = SessionContext::new_with_state(scoped.state.clone());
+    for ctx in [&parent, &captured] {
+        let batches = ctx
+            .execute_logical_plan(LogicalPlan::Statement(Statement::Execute(Execute {
+                name: "scoped_prepared".into(),
+                parameters: vec![],
+            })))
+            .await?
+            .collect()
+            .await?;
+        assert_eq!(batches.iter().map(|b| b.num_rows()).sum::<usize>(), 1);
+    }
+    resources.drain().await?;
+    Ok(())
+}
+
+fn same_registry<T>(before: &HashMap<String, Arc<T>>, after: &HashMap<String, Arc<T>>) {
+    assert!(!before.is_empty());
+    assert_eq!(before.len(), after.len());
+    for (name, value) in before {
+        assert!(Arc::ptr_eq(value, &after[name]));
+    }
+}
+
+#[tokio::test]
+async fn preserves_all_function_maps_and_parent_snapshot_boundary() -> TestResult {
+    let parent = SessionContext::new_with_state(
+        SessionStateBuilder::new()
+            .with_default_features()
+            .with_higher_order_functions(
+                datafusion::functions_nested::all_default_higher_order_functions(),
+            )
+            .build(),
+    );
+    let snapshot = parent.state();
+    let resources = Arc::new(TaskResourceScope::new(Handle::current()));
+    let scoped = ScopedSession::new(snapshot.clone(), resources.clone());
+    same_registry(snapshot.scalar_functions(), scoped.scalar_functions());
+    same_registry(
+        snapshot.higher_order_functions(),
+        scoped.higher_order_functions(),
+    );
+    same_registry(snapshot.aggregate_functions(), scoped.aggregate_functions());
+    same_registry(snapshot.window_functions(), scoped.window_functions());
+    assert!(Arc::ptr_eq(
+        &snapshot.query_planner().clone(),
+        &scoped.query_planner()
+    ));
+    assert_eq!(
+        snapshot.physical_optimizers().len(),
+        scoped.physical_optimizers().len()
+    );
+    for (before, after) in snapshot
+        .physical_optimizers()
+        .iter()
+        .zip(scoped.physical_optimizers())
+    {
+        assert!(Arc::ptr_eq(before, after));
+    }
+    assert!(Arc::ptr_eq(
+        Session::extension_type_registry(&snapshot),
+        scoped.extension_type_registry()
+    ));
+    parent
+        .state_ref()
+        .write()
+        .config_mut()
+        .options_mut()
+        .execution
+        .target_partitions = 17;
+    assert_ne!(scoped.config().target_partitions(), 17);
+    assert_eq!(parent.state().config().target_partitions(), 17);
+    resources.drain().await?;
+    Ok(())
+}
