+#[derive(Debug)]
+struct CheckingPlanner;
+#[tonic::async_trait]
+impl QueryPlanner for CheckingPlanner {
+    async fn create_physical_plan(
+        &self,
+        plan: &LogicalPlan,
+        session: &dyn Session,
+    ) -> Result<Arc<dyn ExecutionPlan>> {
+        assert!(session.as_any().is::<ScopedSession>());
+        DefaultPhysicalPlanner::default()
+            .create_physical_plan(plan, session)
+            .await
+    }
+}
+
+#[derive(Debug)]
+struct CheckingTable {
+    schema: SchemaRef,
+    resources: Arc<TaskResourceScope>,
+}
+#[tonic::async_trait]
+impl TableProvider for CheckingTable {
+    fn schema(&self) -> SchemaRef {
+        self.schema.clone()
+    }
+    fn table_type(&self) -> TableType {
+        TableType::Base
+    }
+    async fn scan(
+        &self,
+        session: &dyn Session,
+        projection: Option<&Vec<usize>>,
+        filters: &[Expr],
+        limit: Option<usize>,
+    ) -> Result<Arc<dyn ExecutionPlan>> {
+        let resources = session.extension::<TaskResourceScope>()?;
+        assert!(Arc::ptr_eq(&resources, &self.resources));
+        let task = session.task_ctx();
+        assert!(Arc::ptr_eq(
+            &task.extension::<TaskResourceScope>()?,
+            &resources
+        ));
+        assert!(Arc::ptr_eq(&task.runtime_env(), session.runtime_env()));
+        let store = session
+            .runtime_env()
+            .object_store(ObjectStoreUrl::parse("memory://scoped")?)?;
+        let response = resources
+            .run(move |_| async move { Ok(store.get(&Path::from("input")).await?.bytes().await?) })
+            .await?;
+        assert_eq!(response.as_ref(), b"child");
+        let batch = RecordBatch::try_new(
+            self.schema.clone(),
+            vec![Arc::new(BooleanArray::from(vec![true]))],
+        )?;
+        MemTable::try_new(self.schema.clone(), vec![vec![batch]])?
+            .scan(session, projection, filters, limit)
+            .await
+    }
+}
+
+#[tokio::test]
+async fn real_provider_and_custom_planner_receive_overlay_and_exact_owner() -> TestResult {
+    let parent = SessionContext::new_with_state(
+        SessionStateBuilder::new()
+            .with_default_features()
+            .with_query_planner(Arc::new(CheckingPlanner))
+            .build(),
+    );
+    let url = ObjectStoreUrl::parse("memory://scoped")?;
+    let original = Arc::new(InMemory::new());
+    original.put(&Path::from("input"), "parent".into()).await?;
+    parent
+        .runtime_env()
+        .register_object_store(url.as_ref(), original.clone());
+    let child = Arc::new(InMemory::new());
+    child.put(&Path::from("input"), "child".into()).await?;
+    let registry = Arc::new(DefaultObjectStoreRegistry::new());
+    registry.register_store(url.as_ref(), child);
+    let resources = Arc::new(TaskResourceScope::new(Handle::current()));
+    let scoped = ScopedSession::new(parent.state(), resources.clone())
+        .with_object_store_registry(registry.clone())?;
+    let table = CheckingTable {
+        schema: Arc::new(Schema::new(vec![Field::new(
+            "ok",
+            DataType::Boolean,
+            false,
+        )])),
+        resources: resources.clone(),
+    };
+    let logical =
+        LogicalPlanBuilder::scan("checking", provider_as_source(Arc::new(table)), None)?.build()?;
+    let batches = collect(
+        scoped.create_physical_plan(&logical).await?,
+        scoped.task_ctx(),
+    )
+    .await?;
+    assert_eq!(batches.iter().map(|b| b.num_rows()).sum::<usize>(), 1);
+    assert!(Arc::ptr_eq(
+        &scoped.runtime_env().object_store_registry,
+        &(registry as Arc<dyn ObjectStoreRegistry>)
+    ));
+    assert!(Arc::ptr_eq(
+        &scoped.runtime_env().memory_pool,
+        &parent.runtime_env().memory_pool
+    ));
+    assert!(Arc::ptr_eq(
+        &scoped.runtime_env().disk_manager,
+        &parent.runtime_env().disk_manager
+    ));
+    assert_eq!(
+        original
+            .get(&Path::from("input"))
+            .await?
+            .bytes()
+            .await?
+            .as_ref(),
+        b"parent"
+    );
+    assert!(parent.extension::<TaskResourceScope>().is_err());
+    assert_eq!(resources.drain().await?.registered, 1);
+    Ok(())
+}
