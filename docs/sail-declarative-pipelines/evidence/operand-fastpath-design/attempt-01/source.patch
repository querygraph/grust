+struct ReplayNoPython;
+impl sail_common_datafusion::error::PythonErrorCauseExtractor for ReplayNoPython {
+    fn extract(_: &(dyn std::error::Error+'static))->Option<sail_common_datafusion::error::PythonErrorCause> {None}
+}
