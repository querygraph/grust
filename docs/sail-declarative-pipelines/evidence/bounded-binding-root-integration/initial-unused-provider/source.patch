+#[test]
+fn binding_names_must_be_canonical_for_the_flow() -> TestResult {
+    // A bare name is not the canonical form the flow qualifies reads to.
+    let bare = source(&["clicks"]);
+    assert_eq!(
+        validate(read("clicks", true), &[bare], &[]),
+        Err(BindingError::NoncanonicalBinding(name(&["clicks"])))
+    );
+    // Upper case is not canonical either; the canonical form is lower-cased.
+    let cased = source(&["c", "d", "Clicks"]);
+    assert_eq!(
+        validate(read("clicks", true), &[cased], &[]),
+        Err(BindingError::NoncanonicalBinding(name(&[
+            "c", "d", "Clicks"
+        ])))
+    );
+    // A local binding must name an output and may not overlap a source.
+    let ctx = SessionContext::new();
+    let graph = graph();
+    let plan = read("events", false);
+    let flow = flow(plan.clone());
+    let local = |parts: &[&str]| -> Result<LocalBinding, Box<dyn std::error::Error>> {
+        Ok(LocalBinding {
+            name: name(parts),
+            identity: "run:1".into(),
+            provider: provider()?,
+        })
+    };
+    assert_eq!(
+        validate_reads(
+            &ctx,
+            &graph,
+            &flow,
+            &plan,
+            &[],
+            &[],
+            &[local(&["c", "d", "nope"])?]
+        ),
+        Err(BindingError::LocalBindingNotAnOutput(name(&[
+            "c", "d", "nope"
+        ])))
+    );
+    assert_eq!(
+        validate_reads(
+            &ctx,
+            &graph,
+            &flow,
+            &plan,
+            &[source(&["c", "d", "events"])],
+            &[],
+            &[local(&["c", "d", "events"])?]
+        ),
+        Err(BindingError::AmbiguousBinding(name(&["c", "d", "events"])))
+    );
+    let reads = validate_reads(
+        &ctx,
+        &graph,
+        &flow,
+        &plan,
+        &[],
+        &[],
+        &[local(&["c", "d", "events"])?],
+    )?;
+    assert_eq!(reads.local, BTreeSet::from([name(&["c", "d", "events"])]));
+    Ok(())
+}
