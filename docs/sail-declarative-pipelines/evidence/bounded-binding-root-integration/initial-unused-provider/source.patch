+fn with_ctes(
+    ctes: Vec<(&str, spec::QueryPlan)>,
+    input: spec::QueryPlan,
+    recursive: bool,
+) -> spec::QueryPlan {
+    spec::QueryPlan::new(spec::QueryNode::WithCtes {
+        input: Box::new(input),
+        recursive,
+        ctes: ctes
+            .into_iter()
+            .map(|(name, plan)| (spec::Identifier::from(name), plan))
+            .collect(),
+    })
+}
