+        .await?;
+    let LogicalPlan::Limit(limit) = plan else {
+        return Err("tail did not resolve to Limit".into());
+    };
+    assert_eq!(limit.skip.as_deref(), Some(&lit(2i64)));
+    fixture.check(1).await
+}
