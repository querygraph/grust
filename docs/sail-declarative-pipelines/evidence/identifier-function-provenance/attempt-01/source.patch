@@ -0,0 +1,39 @@
+use super::PlanResolverState;
+
+impl PlanResolverState {
+    pub fn observe_foldability(&mut self) -> FoldabilityScope<'_> {
+        FoldabilityScope::new(self, Some(true))
+    }
+
+    pub fn suspend_foldability(&mut self) -> FoldabilityScope<'_> {
+        FoldabilityScope::new(self, None)
+    }
+
+    pub fn foldability_observer(&mut self) -> Option<&mut bool> {
+        self.foldability.as_mut()
+    }
+}
+
+/// Observation belongs to one identifier argument. Type-only replacements may
+/// discard their children's observations, then restore the exact parent value.
+pub(in crate::resolver) struct FoldabilityScope<'a> {
+    state: &'a mut PlanResolverState,
+    previous: Option<bool>,
+}
+impl<'a> FoldabilityScope<'a> {
+    fn new(state: &'a mut PlanResolverState, value: Option<bool>) -> Self {
+        let previous = std::mem::replace(&mut state.foldability, value);
+        Self { state, previous }
+    }
+    pub fn state(&mut self) -> &mut PlanResolverState {
+        self.state
+    }
+    pub fn is_foldable(&self) -> bool {
+        self.state.foldability != Some(false)
+    }
+}
+impl Drop for FoldabilityScope<'_> {
+    fn drop(&mut self) {
+        self.state.foldability = self.previous;
+    }
+}
