+#[tokio::test]
+async fn legacy_floating_string_columns_return_null_for_malformed_values() -> TestResult {
+    let ctx = context()?;
+    let resolver = PlanResolver::new(
+        &ctx,
+        Arc::new(PlanConfig {
+            ansi_mode: false,
+            ..Default::default()
+        }),
+    );
+    // Successful values retain native floating semantics, including signed zero,
+    // infinities and overflow/underflow. Malformed values become NULL per row.
+    let source = Arc::new(StringArray::from(vec![
+        Some("1.5"),
+        Some("bad"),
+        None,
+        Some(""),
+        Some("-0.0"),
+        Some("NaN"),
+        Some("Infinity"),
+        Some("-Infinity"),
+        Some("1e1000"),
+        Some("1e-1000"),
+    ])) as ArrayRef;
+    let expected = [
+        Some(1.5_f64),
+        None,
+        None,
+        None,
+        Some(-0.0),
+        Some(f64::NAN),
+        Some(f64::INFINITY),
+        Some(f64::NEG_INFINITY),
+        Some(f64::INFINITY),
+        Some(0.0),
+    ];
+    for string_type in [DataType::Utf8, DataType::LargeUtf8, DataType::Utf8View] {
+        let input = arrow::compute::cast(&source, &string_type)?;
+        let batch = RecordBatch::try_new(
+            Arc::new(Schema::new(vec![Field::new("value", string_type, true)])),
+            vec![input],
+        )?;
+        let schema = Arc::new(DFSchema::try_from(batch.schema())?);
+        for (target, data_type) in [("FLOAT", DataType::Float32), ("DOUBLE", DataType::Float64)] {
+            let expression = resolver
+                .resolve_expression(
+                    from_ast_expression(parse_expression(&format!("CAST(value AS {target})"))?)?,
+                    &schema,
+                    &mut PlanResolverState::new(),
+                )
+                .await?;
+            assert!(matches!(expression, Expr::TryCast(_)));
+            let batches = ctx
+                .read_batch(batch.clone())?
+                .select(vec![expression])?
+                .collect()
+                .await?;
+            assert_eq!(
+                batches.iter().map(RecordBatch::num_rows).sum::<usize>(),
+                expected.len()
+            );
+            let result = arrow::compute::concat(
+                &batches
+                    .iter()
+                    .map(|b| b.column(0).as_ref())
+                    .collect::<Vec<_>>(),
+            )?;
+            assert_eq!(result.data_type(), &data_type);
+            for (row, expected) in expected.iter().enumerate() {
+                let actual = match ScalarValue::try_from_array(&result, row)? {
+                    ScalarValue::Float32(value) => value.map(f64::from),
+                    ScalarValue::Float64(value) => value,
+                    other => return Err(format!("unexpected floating result: {other:?}").into()),
+                };
+                match (actual, expected) {
+                    (Some(actual), Some(expected)) if expected.is_nan() => assert!(actual.is_nan()),
+                    (Some(actual), Some(expected)) => {
+                        assert_eq!(actual.to_bits(), expected.to_bits())
+                    }
+                    (None, None) => {}
+                    other => return Err(format!("row {row}: {other:?}").into()),
+                }
+            }
+        }
+    }
+    Ok(())
+}
