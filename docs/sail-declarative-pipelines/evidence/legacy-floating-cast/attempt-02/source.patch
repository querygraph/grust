+#[tokio::test]
+async fn ansi_floating_cast_errors_and_explicit_try_cast_are_preserved() -> TestResult {
+    for ansi_mode in [true, false] {
+        let ctx = context()?;
+        let resolver = PlanResolver::new(
+            &ctx,
+            Arc::new(PlanConfig {
+                ansi_mode,
+                ..Default::default()
+            }),
+        );
+        for target in ["FLOAT", "DOUBLE"] {
+            for is_try in [true, false] {
+                let sql = format!(
+                    "{}('bad' AS {target})",
+                    if is_try { "TRY_CAST" } else { "CAST" }
+                );
+                let expression = resolver
+                    .resolve_expression(
+                        from_ast_expression(parse_expression(&sql)?)?,
+                        &Arc::new(DFSchema::empty()),
+                        &mut PlanResolverState::new(),
+                    )
+                    .await?;
+                assert_eq!(matches!(expression, Expr::TryCast(_)), is_try || !ansi_mode);
+                let result = ctx.read_empty()?.select(vec![expression])?.collect().await;
+                if ansi_mode && !is_try {
+                    let error = result
+                        .err()
+                        .ok_or("ANSI malformed cast must fail")?
+                        .to_string();
+                    assert!(
+                        error.contains("CAST_INVALID_INPUT") && error.contains("'bad'"),
+                        "{error}"
+                    );
+                } else {
+                    let batches = result?;
+                    assert_eq!(batches.iter().map(RecordBatch::num_rows).sum::<usize>(), 1);
+                    assert!(
+                        batches
+                            .iter()
+                            .all(|b| b.column(0).null_count() == b.num_rows())
+                    );
+                }
+            }
+        }
+    }
+    Ok(())
+}
