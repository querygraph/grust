+#[tokio::test]
+async fn legacy_floating_literal_and_conditional_casts_survive_optimization() -> TestResult {
+    let ctx = context()?;
+    let resolver = PlanResolver::new(
+        &ctx,
+        Arc::new(PlanConfig {
+            ansi_mode: false,
+            ..Default::default()
+        }),
+    );
+    for target in ["FLOAT", "DOUBLE"] {
+        for sql in [
+            format!("SELECT CAST('bad' AS {target}) AS value"),
+            format!(
+                "SELECT CAST('bad' AS {target}) / d AS value FROM VALUES (CAST(NULL AS INT)) AS v(d)"
+            ),
+            format!("SELECT CAST('bad' AS {target}) / d AS value FROM VALUES (0) AS v(d)"),
+        ] {
+            let named = resolver
+                .resolve_named_plan(from_ast_statement(parse_one_statement(&sql)?)?)
+                .await?;
+            let batches = ctx
+                .execute_logical_plan(named.plan)
+                .await?
+                .collect()
+                .await?;
+            assert_eq!(
+                batches.iter().map(RecordBatch::num_rows).sum::<usize>(),
+                1,
+                "{sql}"
+            );
+            assert!(
+                batches
+                    .iter()
+                    .all(|b| b.column(0).null_count() == b.num_rows()),
+                "{sql}"
+            );
+        }
+    }
+    Ok(())
+}
