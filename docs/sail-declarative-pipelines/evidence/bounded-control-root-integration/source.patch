+    assert!(source.scan(&range).is_ok());
+    let new = source.create_partition("p0");
+    assert_ne!(old, new);
+    assert_eq!(
+        source.scan(&range).err(),
+        Some(ScanError::IncarnationMismatch {
+            partition: partition("p0"),
+            expected: old,
+            actual: new,
