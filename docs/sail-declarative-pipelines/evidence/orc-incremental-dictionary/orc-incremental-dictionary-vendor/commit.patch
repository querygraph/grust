+
+    #[test]
+    fn dictionary_factory_preserves_empty_repeated_and_nullable_values_in_both_rle_versions() {
+        let direct = |values: &[u64]| {
+            let mut bytes = vec![0x7e, (values.len() - 1) as u8];
+            for value in values {
+                bytes.extend(value.to_be_bytes());
+            }
+            bytes
+        };
+        for kind in [
+            proto::column_encoding::Kind::Dictionary,
+            proto::column_encoding::Kind::DictionaryV2,
+        ] {
+            let encode = |values: &[u64]| {
+                if kind == proto::column_encoding::Kind::Dictionary {
+                    unsigned_literals(values)
+                } else {
+                    direct(values)
+                }
+            };
+            let output = read(file(
+                Some(3),
+                5,
+                &[0xff, 0xb8],
+                kind,
+                &encode(&[0, 1, 2]),
+                b"abb",
+                &encode(&[1, 2, 1, 0]),
+            ))
+            .unwrap();
+            assert_eq!(
+                output,
+                StringArray::from(vec![Some("a"), None, Some("bb"), Some("a"), Some("")])
+            );
+        }
+    }
