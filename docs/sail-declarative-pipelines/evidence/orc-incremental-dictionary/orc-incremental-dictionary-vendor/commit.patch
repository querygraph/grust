+
+    fn decoder(bytes: Vec<u8>) -> Box<dyn PrimitiveValueDecoder<i64> + Send> {
+        get_unsigned_int_decoder(Cursor::new(bytes), RleVersion::V1)
+    }
+
+    fn bad_varint() -> Vec<u8> {
+        let mut bytes = vec![0xff];
+        bytes.extend([0x80; 11]);
+        bytes
+    }
+
+    fn file(
+        size: Option<u32>,
+        rows: u64,
+        present: &[u8],
+        kind: proto::column_encoding::Kind,
+        lengths: &[u8],
+        dictionary: &[u8],
+        indexes: &[u8],
+    ) -> Bytes {
+        let mut file = b"ORC".to_vec();
+        let mut streams = vec![];
+        for (kind, bytes) in [
+            (proto::stream::Kind::Present, present),
+            (proto::stream::Kind::Length, lengths),
+            (proto::stream::Kind::DictionaryData, dictionary),
+            (proto::stream::Kind::Data, indexes),
+        ] {
+            streams.push(proto::Stream {
+                kind: Some(kind.into()),
+                column: Some(1),
+                length: Some(bytes.len() as u64),
+            });
+            file.extend_from_slice(bytes);
+        }
+        let data_length = file.len() as u64 - 3;
+        let stripe_footer = proto::StripeFooter {
+            streams,
+            columns: vec![
+                proto::ColumnEncoding::default(),
+                proto::ColumnEncoding {
+                    kind: Some(kind.into()),
+                    dictionary_size: size,
+                    ..Default::default()
+                },
+            ],
+            ..Default::default()
+        }
+        .encode_to_vec();
+        let footer = proto::Footer {
+            stripes: vec![proto::StripeInformation {
+                offset: Some(3),
+                index_length: Some(0),
+                data_length: Some(data_length),
+                footer_length: Some(stripe_footer.len() as u64),
+                number_of_rows: Some(rows),
+                ..Default::default()
+            }],
+            types: vec![
+                proto::Type {
+                    kind: Some(proto::r#type::Kind::Struct.into()),
+                    field_names: vec!["value".into()],
+                    subtypes: vec![1],
+                    ..Default::default()
+                },
+                proto::Type {
+                    kind: Some(proto::r#type::Kind::String.into()),
+                    ..Default::default()
+                },
+            ],
+            number_of_rows: Some(rows),
+            ..Default::default()
+        }
+        .encode_to_vec();
+        let postscript = proto::PostScript {
+            footer_length: Some(footer.len() as u64),
+            metadata_length: Some(0),
+            version: vec![0, 12],
+            ..Default::default()
+        }
+        .encode_to_vec();
+        file.extend(stripe_footer);
+        file.extend(footer);
+        file.extend_from_slice(&postscript);
+        file.push(u8::try_from(postscript.len()).unwrap());
+        file.into()
+    }
+
+    fn read(file: Bytes) -> std::result::Result<StringArray, ArrowError> {
+        let batches: Vec<RecordBatch> = ArrowReaderBuilder::try_new(file)
+            .unwrap()
+            .build()
+            .collect::<std::result::Result<_, _>>()?;
+        Ok(batches[0]
+            .column(0)
+            .as_any()
+            .downcast_ref::<StringArray>()
+            .unwrap()
+            .clone())
+    }
+
+    fn native(error: &ArrowError) -> &OrcError {
+        let ArrowError::ExternalError(error) = error else {
+            panic!("expected native error: {error}");
+        };
+        error.downcast_ref().unwrap()
+    }
+
+    #[cfg(target_pointer_width = "64")]
+    #[test]
+    fn huge_declared_count_with_tiny_length_stream_uses_bounded_scratch() {
+        struct Bounded(Box<dyn PrimitiveValueDecoder<i64> + Send>);
+        impl PrimitiveValueDecoder<i64> for Bounded {
+            fn decode(&mut self, out: &mut [i64]) -> Result<()> {
+                assert!(out.len() <= LENGTH_BATCH_SIZE);
+                self.0.decode(out)
+            }
+            fn skip(&mut self, _n: usize) -> Result<()> {
+                panic!("must decode lengths");
+            }
+        }
+        for lengths in [vec![], unsigned_literals(&[0])] {
+            for count in [i32::MAX as usize + 1, u32::MAX as usize] {
+                let mut payload = Cursor::new(b"unread");
+                let error =
+                    read_dictionary(&mut payload, &mut Bounded(decoder(lengths.clone())), count)
+                        .unwrap_err();
+                assert!(
+                    matches!(error, OrcError::OutOfSpec { msg, .. } if msg == "not enough values to decode")
+                );
+                assert_eq!(payload.position(), 0);
+            }
+            let error = read(file(
+                Some(u32::MAX),
+                1,
+                &[0xff],
+                proto::column_encoding::Kind::Dictionary,
+                &lengths,
+                b"unread",
+                &bad_varint(),
+            ))
+            .unwrap_err();
+            assert!(
+                matches!(native(&error), OrcError::OutOfSpec { msg, .. } if msg == "not enough values to decode")
+            );
+        }
+    }
+
+    #[test]
+    fn malformed_dictionary_lengths_precede_payload_reads() {
+        for case in malformed_cases() {
+            let mut payload = Cursor::new(b"unread");
+            let error =
+                read_dictionary(&mut payload, case.decoder().as_mut(), case.count).unwrap_err();
+            assert_error(error, case.expected);
+            assert_eq!(payload.position(), 0);
+        }
+    }
+
+    #[test]
+    fn all_length_decoding_precedes_negative_sum_and_offset_validation() {
+        for invalid in [
+            vec![u64::MAX],
+            vec![i32::MAX as u64 + 1],
+            vec![i64::MAX as u64, 1],
+        ] {
+            for cross_chunk in [false, true] {
+                let mut values = invalid.clone();
+                if cross_chunk {
+                    values.resize(LENGTH_BATCH_SIZE, 0);
+                }
+                let mut encoded = many_unsigned_literals(&values);
+                encoded.extend(bad_varint());
+                let mut payload = Cursor::new(b"unread");
+                let error =
+                    read_dictionary(&mut payload, decoder(encoded).as_mut(), values.len() + 1)
+                        .unwrap_err();
+                assert!(matches!(error, OrcError::VarintTooLarge { .. }));
+                assert_eq!(payload.position(), 0);
+            }
+        }
+        for (values, expected) in [
+            (vec![i32::MAX as u64 + 1, u64::MAX], ExpectedError::Negative),
+            (
+                vec![i64::MAX as u64, 1, u64::MAX],
+                ExpectedError::SumOverflow,
+            ),
+        ] {
+            let error = read_dictionary(
+                &mut Cursor::new(b"unread"),
+                decoder(unsigned_literals(&values)).as_mut(),
+                values.len(),
+            )
+            .unwrap_err();
+            assert_error(error, expected);
+        }
+    }
+
