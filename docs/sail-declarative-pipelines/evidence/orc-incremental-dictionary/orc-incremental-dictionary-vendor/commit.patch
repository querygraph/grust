+use std::io::{self, Read};
+
+use arrow::array::StringArray;
+use arrow::buffer::{Buffer, OffsetBuffer};
+use snafu::{ensure, ResultExt};
+
+use crate::array_decoder::length::check_offset_buffer_size;
+use crate::encoding::PrimitiveValueDecoder;
+use crate::error::{ArrowSnafu, IoSnafu, OffsetOverflowSnafu, OutOfSpecSnafu, Result};
+
+const LENGTH_BATCH_SIZE: usize = 1024;
+
+/// Build dictionary offsets only as the LENGTH stream proves entries exist.
+/// Dictionary entries have no PRESENT stream; row validity belongs to indexes.
+pub(super) fn read_dictionary(
+    bytes: &mut impl Read,
+    lengths: &mut (dyn PrimitiveValueDecoder<i64> + Send),
+    count: usize,
+) -> Result<StringArray> {
+    check_offset_buffer_size::<i32>(count)?;
+    let mut offsets = Vec::new();
+    offsets
+        .try_reserve(1)
+        .map_err(|error| io::Error::new(io::ErrorKind::OutOfMemory, error))
+        .context(IoSnafu)?;
+    offsets.push(0_i32);
+    let mut scratch = [0_i64; LENGTH_BATCH_SIZE];
+    let mut offset_chunk = [0_i32; LENGTH_BATCH_SIZE];
+    let mut remaining = count;
+    let mut total = 0_i64;
+    let mut validation_error = None;
+    while remaining > 0 {
+        let chunk_size = remaining.min(scratch.len());
+        lengths.decode(&mut scratch[..chunk_size])?;
+        // Preserve the former full-batch ordering: any LENGTH decoding error
+        // precedes length validation, which precedes DICTIONARY_DATA reads.
+        if validation_error.is_none() {
+            for (&length, offset) in scratch[..chunk_size]
+                .iter()
+                .zip(&mut offset_chunk[..chunk_size])
+            {
+                if length < 0 {
+                    validation_error = Some(
+                        OutOfSpecSnafu {
+                            msg: "Decoded array length is negative",
+                        }
+                        .build(),
+                    );
+                    break;
+                }
+                let Some(next) = total.checked_add(length) else {
+                    validation_error = Some(
+                        OutOfSpecSnafu {
+                            msg: "Decoded array lengths overflow i64",
+                        }
+                        .build(),
+                    );
+                    break;
+                };
+                total = next;
+                if let Ok(value) = i32::try_from(total) {
+                    *offset = value;
+                }
+            }
+            // No later nonnegative length can repair an offset overflow. Stop
+            // retaining offsets, but finish LENGTH decoding/validation first.
+            if validation_error.is_none() && total <= i64::from(i32::MAX) {
+                offsets
+                    .try_reserve(chunk_size)
+                    .map_err(|error| io::Error::new(io::ErrorKind::OutOfMemory, error))
+                    .context(IoSnafu)?;
+                offsets.extend_from_slice(&offset_chunk[..chunk_size]);
+            }
+        }
+        remaining -= chunk_size;
+    }
+    if let Some(error) = validation_error {
+        return Err(error);
+    }
+    ensure!(
+        total <= i64::from(i32::MAX),
+        OffsetOverflowSnafu {
+            total_length: total,
+            max_size: i32::MAX,
+            batch_size: count,
+        }
+    );
+    let total = usize::try_from(total).map_err(|_| {
+        OutOfSpecSnafu {
+            msg: "Decoded array length does not fit usize",
+        }
+        .build()
+    })?;
+
+    // Keep the materialized payload allocation/read/Arrow validation policy.
+    let mut data = Vec::new();
+    data.try_reserve_exact(total)
+        .map_err(|error| io::Error::new(io::ErrorKind::OutOfMemory, error))
+        .context(IoSnafu)?;
+    bytes
+        .take(total as u64)
+        .read_to_end(&mut data)
+        .context(IoSnafu)?;
+    StringArray::try_new(OffsetBuffer::new(offsets.into()), Buffer::from(data), None)
+        .context(ArrowSnafu)
+}
