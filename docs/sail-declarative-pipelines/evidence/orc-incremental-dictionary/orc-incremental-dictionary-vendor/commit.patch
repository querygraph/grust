+        assert_eq!(dictionary.value(LENGTH_BATCH_SIZE), "x");
+        let indexes = Int64ArrayDecoder::new(
+            decoder(unsigned_literals(&[LENGTH_BATCH_SIZE as u64])),
+            None,
+        );
+        let mut decoder =
+            super::super::DictionaryStringArrayDecoder::new(indexes, Arc::new(dictionary)).unwrap();
+        let output = decoder
+            .next_batch(2, Some(&NullBuffer::from(vec![false, true])))
+            .unwrap();
+        assert_eq!(
+            output.as_any().downcast_ref::<StringArray>().unwrap(),
+            &StringArray::from(vec![None, Some("x")])
+        );
+    }
+
+    #[test]
+    fn dictionary_payload_truncation_utf8_and_io_errors_keep_their_categories() {
+        for (length, data) in [(2, b"a".as_slice()), (1, &[0xff])] {
+            let error = read_dictionary(
+                &mut Cursor::new(data),
+                decoder(unsigned_literals(&[length])).as_mut(),
+                1,
+            )
+            .unwrap_err();
+            assert!(matches!(error, OrcError::Arrow { .. }));
+        }
+        let mut payload = Decompressor::new(
+            Bytes::from_static(&[0xff]),
+            Compression::from_proto(proto::CompressionKind::Zlib, None),
+            vec![],
+        );
+        let error = read_dictionary(&mut payload, decoder(unsigned_literals(&[1])).as_mut(), 1)
+            .unwrap_err();
+        let OrcError::IoError { source, .. } = error else {
+            panic!("expected original I/O error");
+        };
+        assert_eq!(source.kind(), io::ErrorKind::InvalidData);
+        assert!(source
+            .get_ref()
+            .unwrap()
+            .downcast_ref::<OrcError>()
+            .is_some());
+    }
+}
