+#[test]
+fn decimal_codec_rejects_malformed_and_out_of_range_fields() -> Result<()> {
+    for (precision, scale, name) in [
+        (0, 0, "spark_string_to_decimal"),
+        (39, 0, "spark_string_to_decimal"),
+        (256, 0, "spark_string_to_decimal"),
+        (u32::MAX, 0, "spark_string_to_decimal"),
+        (5, 6, "spark_string_to_decimal"),
+        (5, 128, "spark_string_to_decimal"),
+        (5, -129, "spark_string_to_decimal"),
+        (5, i32::MAX, "spark_string_to_decimal"),
+        (5, i32::MIN, "spark_string_to_decimal"),
+        (5, 2, "another_function"),
+    ] {
+        let bytes = ExtendedScalarUdf {
+            udf_kind: Some(UdfKind::SparkStringToDecimal(
+                r#gen::SparkStringToDecimalUdf {
+                    precision,
+                    scale,
+                    fail_on_error: true,
+                    allow_negative_scale: true,
+                },
+            )),
+        }
+        .encode_to_vec();
+        assert!(
+            RemoteExecutionCodec.try_decode_udf(name, &bytes).is_err(),
+            "{precision},{scale},{name}"
+        );
+    }
+    for bytes in [vec![], vec![0xff]] {
+        assert!(
+            RemoteExecutionCodec
+                .try_decode_udf("spark_string_to_decimal", &bytes)
+                .is_err()
+        );
+    }
+    let mut bytes = ExtendedScalarUdf {
+        udf_kind: Some(UdfKind::SparkStringToDecimal(
+            r#gen::SparkStringToDecimalUdf {
+                precision: 5,
+                scale: 2,
+                fail_on_error: true,
+                allow_negative_scale: true,
+            },
+        )),
+    }
+    .encode_to_vec();
+    bytes.pop();
+    assert!(
+        RemoteExecutionCodec
+            .try_decode_udf("spark_string_to_decimal", &bytes)
+            .is_err()
+    );
+    Ok(())
+}
