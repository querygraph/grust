+#[test]
+fn decimal_codec_preserves_lazy_thunks_in_full_physical_round_trip() -> Result<()> {
+    for data_type in [DataType::Utf8, DataType::LargeUtf8, DataType::Utf8View] {
+        let schema = Arc::new(Schema::new(vec![
+            Field::new("text", data_type.clone(), true),
+            Field::new("right", DataType::Int32, true),
+        ]));
+        let strings = ColumnarValue::Array(Arc::new(StringArray::from(vec![
+            Some("bad"),
+            Some("1.235"),
+            None,
+        ])))
+        .cast_to(&data_type, None)?
+        .into_array(3)?;
+        let batch = RecordBatch::try_new(
+            Arc::clone(&schema),
+            vec![
+                strings,
+                Arc::new(Int32Array::from(vec![None, Some(2), Some(0)])),
+            ],
+        )?;
+        for fail in [true, false] {
+            for allow in [true, false] {
+                let cast = ScalarUDF::from(SparkStringToDecimal::try_new(5, 2, fail, allow)?)
+                    .call(vec![col("text")]);
+                for ansi in [true, false] {
+                    // The operation returns the left value to isolate lazy casting;
+                    // this fixture is not a SQL division/coercion parity assertion.
+                    let operation = Expr::LambdaVariable(LambdaVariable::new(
+                        "lv".into(),
+                        Some(Arc::new(Field::new("lv", DataType::Decimal128(5, 2), true))),
+                    ));
+                    let logical = Expr::HigherOrderFunction(HigherOrderFunction::new(
+                        Arc::new(HigherOrderUDF::new_from_impl(SparkDivModLazy::new(ansi))),
+                        vec![
+                            lambda(["unused_r"], col("right")),
+                            lambda(["unused_l"], cast.clone()),
+                            lambda(["lv", "rv"], operation),
+                        ],
+                    ));
+                    let original = create_physical_expr(
+                        &logical,
+                        &DFSchema::try_from(schema.as_ref().clone())?,
+                        &ExecutionProps::new(),
+                        &PhysicalPlanningContext::default(),
+                    )?;
+                    let bytes = try_encode_physical_expr(&RemoteExecutionCodec, &original)?;
+                    let decoded = try_decode_physical_expr(
+                        &TaskContext::default(),
+                        &RemoteExecutionCodec,
+                        &bytes,
+                        schema.as_ref(),
+                    )?;
+                    for expr in [&original, &decoded] {
+                        assert_eq!(expr.data_type(schema.as_ref())?, DataType::Decimal128(5, 2));
+                        assert!(expr.nullable(schema.as_ref())?);
+                        let actual = expr.evaluate(&batch)?.into_array(3)?;
+                        assert_eq!(
+                            actual.as_ref(),
+                            &Decimal128Array::from(vec![None, Some(124), None])
+                                .with_precision_and_scale(5, 2)?
+                                as &dyn Array
+                        );
+                        let empty = batch.slice(0, 0);
+                        assert!(expr.evaluate(&empty)?.into_array(0)?.is_empty());
+                    }
+                }
+            }
+        }
+    }
+    Ok(())
+}
