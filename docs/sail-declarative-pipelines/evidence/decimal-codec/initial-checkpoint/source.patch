+use datafusion::arrow::array::{Array, Decimal128Array, Int32Array, RecordBatch, StringArray};
+use datafusion::common::DFSchema;
+use datafusion::common::config::ConfigOptions;
+use datafusion::logical_expr::execution_props::ExecutionProps;
+use datafusion::logical_expr::expr::{HigherOrderFunction, LambdaVariable};
+use datafusion::logical_expr::physical_planning_context::PhysicalPlanningContext;
+use datafusion::logical_expr::{
+    ColumnarValue, Expr, HigherOrderUDF, ScalarFunctionArgs, col, lambda,
+};
+use datafusion::physical_expr::create_physical_expr;
+use sail_common_datafusion::error::{
+    CommonErrorCause, PythonErrorCause, PythonErrorCauseExtractor, StructuredSparkError,
+};
+use sail_function::scalar::math::div_mod_lazy::SparkDivModLazy;
+
+use super::*;
+
+struct NoPython;
+impl PythonErrorCauseExtractor for NoPython {
+    fn extract(_: &(dyn std::error::Error + 'static)) -> Option<PythonErrorCause> {
+        None
+    }
+}
+
+fn round_trip(precision: u8, scale: i8, fail: bool, allow: bool) -> Result<Arc<ScalarUDF>> {
+    let original = ScalarUDF::from(SparkStringToDecimal::try_new(
+        precision, scale, fail, allow,
+    )?);
+    let mut bytes = vec![];
+    RemoteExecutionCodec.try_encode_udf(&original, &mut bytes)?;
+    let definition =
+        ExtendedScalarUdf::decode(bytes.as_slice()).map_err(|e| plan_datafusion_err!("{e}"))?;
+    assert!(
+        matches!(definition.udf_kind,Some(UdfKind::SparkStringToDecimal(ref p))
+        if p.precision==u32::from(precision) && p.scale==i32::from(scale)
+        && p.fail_on_error==fail && p.allow_negative_scale==allow)
+    );
+    let decoded = RemoteExecutionCodec.try_decode_udf(original.name(), &bytes)?;
+    let implementation = decoded
+        .inner()
+        .downcast_ref::<SparkStringToDecimal>()
+        .ok_or_else(|| plan_datafusion_err!("decoded wrong decimal implementation"))?;
+    assert_eq!(
+        (
+            implementation.precision(),
+            implementation.scale(),
+            implementation.fail_on_error(),
+            implementation.allow_negative_scale()
+        ),
+        (precision, scale, fail, allow)
+    );
+    assert_eq!(decoded.signature(), original.signature());
+    Ok(decoded)
+}
+
+fn invoke(function: &ScalarUDF, p: u8, s: i8, input: ColumnarValue) -> Result<ColumnarValue> {
+    let rows = match &input {
+        ColumnarValue::Array(a) => a.len(),
+        _ => 1,
+    };
+    function.invoke_with_args(ScalarFunctionArgs {
+        arg_fields: vec![Arc::new(Field::new("source", input.data_type(), true))],
+        args: vec![input],
+        number_rows: rows,
+        return_field: Arc::new(Field::new("result", DataType::Decimal128(p, s), true)),
+        config_options: Arc::new(ConfigOptions::default()),
+    })
+}
+
+fn structured(result: Result<ColumnarValue>) -> Result<Box<StructuredSparkError>> {
+    let error = result
+        .err()
+        .ok_or_else(|| plan_datafusion_err!("expected typed decimal failure"))?;
+    let CommonErrorCause::Structured(error) = CommonErrorCause::new::<NoPython>(&error) else {
+        return plan_err!("lost structured decimal failure: {error}");
+    };
+    Ok(error)
+}
+
+#[test]
+fn decimal_codec_preserves_all_captured_fields_and_values() -> Result<()> {
+    for (p, s, source, value) in [
+        (5, 2, "1.235", 124_i128),
+        (38, 10, "1.235", 12_350_000_000),
+        (5, -2, "150", 2),
+    ] {
+        for fail in [true, false] {
+            for allow in [true, false] {
+                let decoded = round_trip(p, s, fail, allow)?;
+                for data_type in [DataType::Utf8, DataType::LargeUtf8, DataType::Utf8View] {
+                    let input = ColumnarValue::Scalar(ScalarValue::Utf8(Some(source.into())))
+                        .cast_to(&data_type, None)?;
+                    let ColumnarValue::Scalar(actual) = invoke(&decoded, p, s, input)? else {
+                        return plan_err!("scalar became array");
+                    };
+                    assert_eq!(actual, ScalarValue::Decimal128(Some(value), p, s));
+                    let input =
+                        ColumnarValue::Array(Arc::new(StringArray::from(vec![None, Some(source)])))
+                            .cast_to(&data_type, None)?;
+                    let actual = invoke(&decoded, p, s, input)?.into_array(2)?;
+                    assert_eq!(
+                        actual.as_ref(),
+                        &Decimal128Array::from(vec![None, Some(value)])
+                            .with_precision_and_scale(p, s)? as &dyn Array
+                    );
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+#[test]
+fn decimal_codec_preserves_typed_error_vocabulary() -> Result<()> {
+    for fail in [true, false] {
+        for allow in [true, false] {
+            let decoded = round_trip(5, 2, fail, allow)?;
+            for source in ["bad", "999.995", "1e39"] {
+                let input = ColumnarValue::Scalar(ScalarValue::Utf8(Some(source.into())));
+                let result = invoke(&decoded, 5, 2, input);
+                if !fail {
+                    assert!(matches!(
+                        result?,
+                        ColumnarValue::Scalar(ScalarValue::Decimal128(None, 5, 2))
+                    ));
+                    continue;
+                }
+                let error = structured(result)?;
+                if source == "bad" {
+                    assert_eq!(error.class, "java.lang.NumberFormatException");
+                    assert_eq!(error.condition, "CAST_INVALID_INPUT");
+                    assert_eq!(error.sql_state, "22018");
+                    assert_eq!(
+                        error.parameters,
+                        HashMap::from([
+                            ("expression".into(), "'bad'".into()),
+                            ("sourceType".into(), "\"STRING\"".into()),
+                            ("targetType".into(), "\"DECIMAL(5,2)\"".into()),
+                            ("ansiConfig".into(), "\"spark.sql.ansi.enabled\"".into()),
+                        ])
+                    );
+                } else {
+                    assert_eq!(error.class, "org.apache.spark.SparkArithmeticException");
+                    assert_eq!(error.sql_state, "22003");
+                    if source == "1e39" && !allow {
+                        assert_eq!(error.condition, "NUMERIC_OUT_OF_SUPPORTED_RANGE");
+                        assert_eq!(
+                            error.parameters,
+                            HashMap::from([("value".into(), source.into())])
+                        );
+                    } else {
+                        assert_eq!(
+                            error.condition,
+                            "NUMERIC_VALUE_OUT_OF_RANGE.WITH_SUGGESTION"
+                        );
+                        let value = if source == "1e39" {
+                            format!("1{}", "0".repeat(39))
+                        } else {
+                            source.into()
+                        };
+                        assert_eq!(
+                            error.parameters,
+                            HashMap::from([
+                                ("value".into(), value),
+                                ("precision".into(), "5".into()),
+                                ("scale".into(), "2".into()),
+                                ("config".into(), "\"spark.sql.ansi.enabled\"".into()),
+                            ])
+                        );
+                    }
+                }
+            }
+        }
+    }
+    Ok(())
+}
