diff --git a/crates/sail-plan/src/function/constant_context.rs b/crates/sail-plan/src/function/constant_context.rs
new file mode 100644
index 000000000..cdea0d596
--- /dev/null
+++ b/crates/sail-plan/src/function/constant_context.rs
@@ -0,0 +1,25 @@
+/// Controls lowering while resolving SQL constant-name expressions.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub enum ConstantContext {
+    #[default]
+    Ordinary,
+    Identifier,
+}
+
+impl ConstantContext {
+    /// Retain function provenance until the identifier's foldability check.
+    pub(crate) fn retain_function_foldability(self) -> bool {
+        match self {
+            Self::Ordinary => false,
+            Self::Identifier => true,
+        }
+    }
+
+    /// Validate the identifier's type before evaluating constant arithmetic.
+    pub(crate) fn defer_arithmetic_evaluation(self) -> bool {
+        match self {
+            Self::Ordinary => false,
+            Self::Identifier => true,
+        }
+    }
+}
