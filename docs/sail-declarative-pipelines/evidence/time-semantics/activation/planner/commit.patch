+}
+
+pub(super) fn time_cast(source: spec::Expr, target: spec::DataType, is_try: bool) -> spec::Expr {
+    spec::Expr::Cast {
+        expr: Box::new(source),
+        cast_to_type: target,
+        rename: true,
+        is_try,
+    }
+}
+
