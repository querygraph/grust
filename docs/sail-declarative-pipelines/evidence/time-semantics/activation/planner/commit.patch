+            0,
+            45_296_000_000_000,
+        ),
+        (
+            Arc::new(Time32MillisecondArray::from(vec![Some(45_296_123), None])),
+            3,
+            45_296_123_000_000,
+        ),
+        (
+            Arc::new(Time64MicrosecondArray::from(vec![
+                Some(45_296_123_456),
+                None,
+            ])),
+            6,
+            NANOS,
+        ),
+        (
+            Arc::new(Time64NanosecondArray::from(vec![Some(NANOS), None])),
