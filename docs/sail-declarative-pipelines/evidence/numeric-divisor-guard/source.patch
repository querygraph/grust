+#[test]
+fn numeric_divisor_codec_preserves_kind_mode_and_execution() -> Result<()> {
+    for (kind, condition) in [
+        (ZeroDivisionKind::Divide, "DIVIDE_BY_ZERO"),
+        (ZeroDivisionKind::Remainder, "REMAINDER_BY_ZERO"),
+    ] {
+        for ansi in [true, false] {
+            let original = ScalarUDF::from(SafeNumericDivisor::new(kind, ansi));
+            let mut bytes = vec![];
+            RemoteExecutionCodec.try_encode_udf(&original, &mut bytes)?;
+            let definition = ExtendedScalarUdf::decode(bytes.as_slice())
+                .map_err(|e| plan_datafusion_err!("invalid guard definition: {e}"))?;
+            assert!(matches!(
+                definition.udf_kind,
+                Some(UdfKind::Standard(r#gen::StandardUdf {}))
+            ));
+            let decoded = RemoteExecutionCodec.try_decode_udf(original.name(), &bytes)?;
+            assert_eq!(decoded.name(), original.name());
+            assert_eq!(decoded.signature(), original.signature());
+            assert!(decoded.inner().is::<SafeNumericDivisor>());
+            for value in [Some(4.0), None, Some(0.0), Some(-0.0)] {
+                let input = ScalarValue::Float64(value);
+                let field = Arc::new(Field::new("divisor", DataType::Float64, true));
+                let result = decoded.invoke_with_args(ScalarFunctionArgs {
+                    args: vec![ColumnarValue::Scalar(input.clone())],
+                    arg_fields: vec![field.clone()],
+                    number_rows: 1,
+                    return_field: field,
+                    config_options: Arc::new(ConfigOptions::default()),
+                });
+                if ansi && value.is_some_and(|v| v == 0.0) {
+                    let error = result
+                        .err()
+                        .ok_or_else(|| plan_datafusion_err!("decoded guard accepted zero"))?;
+                    let CommonErrorCause::Structured(error) =
+                        CommonErrorCause::new::<NoPython>(&error)
+                    else {
+                        return plan_err!("decoded guard lost structured error: {error}");
+                    };
+                    assert_eq!(error.condition, condition);
+                    assert_eq!(error.sql_state, "22012");
+                } else {
+                    let expected = if value.is_some_and(|v| v == 0.0) {
+                        ScalarValue::Float64(None)
+                    } else {
+                        input
+                    };
+                    let ColumnarValue::Scalar(actual) = result? else {
+                        return plan_err!("decoded guard changed scalar representation");
+                    };
+                    assert_eq!(actual, expected);
+                }
+            }
+        }
+    }
+    Ok(())
+}
diff --git a/crates/sail-function/src/scalar/math/divisor.rs b/crates/sail-function/src/scalar/math/divisor.rs
new file mode 100644
index 000000000..d137b2925
--- /dev/null
+++ b/crates/sail-function/src/scalar/math/divisor.rs
@@ -0,0 +1,111 @@
+use std::sync::Arc;
+
+use datafusion::arrow::compute::kernels::cmp::eq;
+use datafusion::arrow::compute::{nullif, or};
+use datafusion::arrow::datatypes::{DataType, FieldRef};
+use datafusion_common::{Result, ScalarValue};
+use datafusion_expr::{
+    ColumnarValue, ReturnFieldArgs, ScalarFunctionArgs, ScalarUDFImpl, Signature, Volatility,
+};
+
+use crate::error::{invalid_arg_count_exec_err, unsupported_data_type_exec_err};
+use crate::scalar::math::zero_division::ZeroDivisionKind;
+
+/// Check an already evaluated numeric divisor without changing its datatype.
+/// Keeping the check in one function avoids CASE nullability evaluation and
+/// repeated evaluation of volatile/window operands.
+#[derive(Debug, PartialEq, Eq, Hash)]
+pub struct SafeNumericDivisor {
+    kind: ZeroDivisionKind,
+    ansi: bool,
+    signature: Signature,
+}
+
+impl SafeNumericDivisor {
+    pub fn new(kind: ZeroDivisionKind, ansi: bool) -> Self {
+        Self {
+            kind,
+            ansi,
+            signature: Signature::any(1, Volatility::Immutable),
+        }
+    }
+    fn validate(&self, data_type: &DataType) -> Result<()> {
+        if data_type.is_numeric() || matches!(data_type, DataType::Null) {
+            Ok(())
+        } else {
+            Err(unsupported_data_type_exec_err(
+                self.name(),
+                "numeric or NULL",
+                data_type,
+            ))
+        }
+    }
+}
+
+impl ScalarUDFImpl for SafeNumericDivisor {
+    fn name(&self) -> &str {
+        match (self.kind, self.ansi) {
+            (ZeroDivisionKind::Divide, true) => "spark_divisor_ansi_divide",
+            (ZeroDivisionKind::Remainder, true) => "spark_divisor_ansi_remainder",
+            (ZeroDivisionKind::Divide, false) => "spark_divisor_legacy_divide",
+            (ZeroDivisionKind::Remainder, false) => "spark_divisor_legacy_remainder",
+        }
+    }
+    fn signature(&self) -> &Signature {
+        &self.signature
+    }
+    fn return_type(&self, types: &[DataType]) -> Result<DataType> {
+        let [data_type] = types else {
+            return Err(invalid_arg_count_exec_err(self.name(), (1, 1), types.len()));
+        };
+        self.validate(data_type)?;
+        Ok(data_type.clone())
+    }
+    fn return_field_from_args(&self, args: ReturnFieldArgs) -> Result<FieldRef> {
+        let [field] = args.arg_fields else {
+            return Err(invalid_arg_count_exec_err(
+                self.name(),
+                (1, 1),
+                args.arg_fields.len(),
+            ));
+        };
+        self.validate(field.data_type())?;
+        Ok(Arc::new(field.as_ref().clone().with_nullable(true)))
+    }
+    fn invoke_with_args(&self, args: ScalarFunctionArgs) -> Result<ColumnarValue> {
+        let [input] = args.args.as_slice() else {
+            return Err(invalid_arg_count_exec_err(
+                self.name(),
+                (1, 1),
+                args.args.len(),
+            ));
+        };
+        let data_type = input.data_type();
+        self.validate(&data_type)?;
+        if data_type == DataType::Null {
+            return Ok(input.clone());
+        }
+        let array = input.to_array(1)?;
+        let zero = ScalarValue::new_zero(&data_type)?;
+        let mut zeros = eq(&array, &zero.to_scalar()?)?;
+        if data_type.is_floating() {
+            // Arrow total-order equality distinguishes the two signs of zero.
+            zeros = or(
+                &zeros,
+                &eq(&array, &zero.arithmetic_negate()?.to_scalar()?)?,
+            )?;
+        }
+        if zeros.true_count() == 0 {
+            return Ok(input.clone());
+        }
+        if self.ansi {
+            return Err(self.kind.error());
+        }
+        match input {
+            ColumnarValue::Scalar(_) => Ok(ColumnarValue::Scalar(ScalarValue::try_new_null(
+                &data_type,
+            )?)),
+            ColumnarValue::Array(_) => Ok(ColumnarValue::Array(nullif(array.as_ref(), &zeros)?)),
+        }
+    }
+}
diff --git a/crates/sail-function/src/scalar/math/divisor_tests.rs b/crates/sail-function/src/scalar/math/divisor_tests.rs
new file mode 100644
index 000000000..e02b1cead
--- /dev/null
+++ b/crates/sail-function/src/scalar/math/divisor_tests.rs
@@ -0,0 +1,144 @@
+use std::sync::Arc;
+
+use datafusion::arrow::array::{Array, Float64Array};
+use datafusion::arrow::datatypes::{DataType, Field};
+use datafusion::common::config::ConfigOptions;
+use datafusion_common::{Result, ScalarValue};
+use datafusion_expr::{ColumnarValue, ReturnFieldArgs, ScalarFunctionArgs, ScalarUDF};
+
+use super::divisor::SafeNumericDivisor;
+use super::zero_division::ZeroDivisionKind;
+
+fn invoke(guard: &ScalarUDF, value: ColumnarValue) -> Result<ColumnarValue> {
+    let field = Arc::new(Field::new("divisor", value.data_type(), true));
+    let rows = match &value {
+        ColumnarValue::Array(a) => a.len(),
+        _ => 1,
+    };
+    guard.invoke_with_args(ScalarFunctionArgs {
+        args: vec![value],
+        arg_fields: vec![field.clone()],
+        number_rows: rows,
+        return_field: field,
+        config_options: Arc::new(ConfigOptions::default()),
+    })
+}
+
+#[test]
+fn guard_preserves_numeric_types_nulls_and_scalar_representation() -> Result<()> {
+    for data_type in [
+        DataType::Int8,
+        DataType::Int16,
+        DataType::Int32,
+        DataType::Int64,
+        DataType::UInt8,
+        DataType::UInt16,
+        DataType::UInt32,
+        DataType::UInt64,
+        DataType::Float16,
+        DataType::Float32,
+        DataType::Float64,
+        DataType::Decimal32(6, 2),
+        DataType::Decimal64(12, 2),
+        DataType::Decimal128(20, 5),
+        DataType::Decimal256(45, 5),
+        DataType::Null,
+    ] {
+        for ansi in [true, false] {
+            let guard = ScalarUDF::from(SafeNumericDivisor::new(ZeroDivisionKind::Divide, ansi));
+            let null = ScalarValue::try_new_null(&data_type)?;
+            let ColumnarValue::Scalar(actual) =
+                invoke(&guard, ColumnarValue::Scalar(null.clone()))?
+            else {
+                return datafusion_common::internal_err!("scalar null became an array");
+            };
+            assert_eq!(actual, null);
+            let field = Arc::new(
+                Field::new("divisor", data_type.clone(), false).with_metadata(
+                    std::collections::HashMap::from([("owner".into(), "test".into())]),
+                ),
+            );
+            let output = guard.return_field_from_args(ReturnFieldArgs {
+                arg_fields: std::slice::from_ref(&field),
+                scalar_arguments: &[None],
+            })?;
+            assert_eq!(output.data_type(), &data_type);
+            assert!(output.is_nullable());
+            assert_eq!(output.metadata(), field.metadata());
+            if data_type == DataType::Null {
+                continue;
+            }
+            let zero = ScalarValue::new_zero(&data_type)?;
+            let result = invoke(&guard, ColumnarValue::Scalar(zero));
+            if ansi {
+                assert!(
+                    result
+                        .err()
+                        .is_some_and(|e| e.to_string().contains("DIVIDE_BY_ZERO"))
+                );
+            } else {
+                let ColumnarValue::Scalar(actual) = result? else {
+                    return datafusion_common::internal_err!("scalar zero became an array");
+                };
+                assert_eq!(actual, null);
+            }
+        }
+    }
+    Ok(())
+}
+
+#[test]
+fn guard_handles_signed_zero_nan_infinity_and_sliced_arrays() -> Result<()> {
+    let values = Float64Array::from(vec![
+        Some(99.0),
+        None,
+        Some(0.0),
+        Some(-0.0),
+        Some(2.0),
+        Some(f64::NAN),
+        Some(f64::INFINITY),
+    ])
+    .slice(1, 6);
+    let guard = ScalarUDF::from(SafeNumericDivisor::new(ZeroDivisionKind::Remainder, false));
+    let ColumnarValue::Array(result) = invoke(&guard, ColumnarValue::Array(Arc::new(values)))?
+    else {
+        return datafusion_common::internal_err!("array became scalar");
+    };
+    let actual = result
+        .as_any()
+        .downcast_ref::<Float64Array>()
+        .ok_or_else(|| datafusion_common::internal_datafusion_err!("changed float datatype"))?;
+    assert_eq!(actual.len(), 6);
+    for i in 0..3 {
+        assert!(actual.is_null(i));
+    }
+    assert_eq!(actual.value(3), 2.0);
+    assert!(actual.value(4).is_nan());
+    assert_eq!(actual.value(5), f64::INFINITY);
+    let ansi = ScalarUDF::from(SafeNumericDivisor::new(ZeroDivisionKind::Remainder, true));
+    for value in [0.0, -0.0] {
+        let error = invoke(
+            &ansi,
+            ColumnarValue::Scalar(ScalarValue::Float64(Some(value))),
+        )
+        .err()
+        .ok_or_else(|| datafusion_common::internal_datafusion_err!("zero was accepted"))?;
+        assert!(error.to_string().contains("REMAINDER_BY_ZERO"));
+    }
+    for value in [f64::NAN, f64::INFINITY, 2.0] {
+        let ColumnarValue::Scalar(ScalarValue::Float64(Some(actual))) = invoke(
+            &ansi,
+            ColumnarValue::Scalar(ScalarValue::Float64(Some(value))),
+        )?
+        else {
+            return datafusion_common::internal_err!("changed scalar representation");
+        };
+        assert_eq!(actual.to_bits(), value.to_bits());
+    }
+    let empty = Arc::new(Float64Array::from(Vec::<f64>::new()));
+    let ColumnarValue::Array(result) = invoke(&ansi, ColumnarValue::Array(empty))? else {
+        return datafusion_common::internal_err!("empty array became scalar");
+    };
+    assert_eq!(result.len(), 0);
+    Ok(())
+}
