+    struct BoundedBoolean(BooleanDecoder<Cursor<Vec<u8>>>);
+    impl PrimitiveValueDecoder<bool> for BoundedBoolean {
+        fn decode(&mut self, out: &mut [bool]) -> Result<()> {
+            assert!(out.len() <= length::SKIP_BATCH_SIZE);
+            self.0.decode(out)
