{
  "run_id": "pecan-review",
  "docker_context": "colima-sail-gate",
  "image": "sail-pecan-benchmark:release",
  "target_volume": "sail-extension-targets",
  "container_python": "/targets/pecan-benchmark/venv/bin/python",
  "container_repo": "/targets/pecan-benchmark/candidate",
  "container_sail_binary": "/targets/pecan-benchmark/release/host/release/sail",
  "runtime_source_sha": "0000000000000000000000000000000000000000",
  "native_source_sha": "0000000000000000000000000000000000000000",
  "harness_source_sha": "0000000000000000000000000000000000000000",
  "container_root": "/targets/pecan-benchmark/runs/pecan-review",
  "host_output": "/absolute/path/to/pecan-review-evidence",
  "seed": 20260927,
  "variants": [
    "reference",
    "optimized"
  ],
  "limits": {
    "cpus": 8,
    "cpuset_cpus": "0-7",
    "memory_gib": 32,
    "outer_timeout_seconds": 1440
  },
  "defaults": {
    "partitions": 8,
    "threads": 8,
    "worker_task_slots": 32,
    "sail_pool_bytes": 17179869184,
    "native_quota": 8589934592,
    "tolerance": 1e-08,
    "damping": 0.85,
    "max_iterations": 1000,
    "timeout": 600,
    "seed": 42
  },
  "datasets": {
    "sparse-10000": {
      "family": "sparse",
      "vertices": 10000,
      "degree": 8,
      "block_size": 1024,
      "seed": 20260927
    },
    "sparse-100000": {
      "family": "sparse",
      "vertices": 100000,
      "degree": 8,
      "block_size": 1024,
      "seed": 20260927
    },
    "sparse-1000000": {
      "family": "sparse",
      "vertices": 1000000,
      "degree": 8,
      "block_size": 1024,
      "seed": 20260927
    },
    "chain-512": {
      "family": "chain",
      "vertices": 512,
      "seed": 20260927
    }
  },
  "suites": [
    {
      "name": "distributed",
      "mode": "process-cluster",
      "datasets": [
        "sparse-10000",
        "sparse-100000",
        "sparse-1000000"
      ],
      "algorithms": [
        "pagerank",
        "wcc"
      ],
      "repetitions": 3
    },
    {
      "name": "local",
      "mode": "local",
      "datasets": [
        "sparse-100000"
      ],
      "algorithms": [
        "pagerank",
        "wcc"
      ],
      "repetitions": 3
    },
    {
      "name": "chain-diagnostic",
      "mode": "process-cluster",
      "datasets": [
        "chain-512"
      ],
      "algorithms": [
        "wcc"
      ],
      "repetitions": 1,
      "max_iterations": 100,
      "diagnostic": true,
      "expected_outcomes": {
        "reference": {
          "pecan": "nonconverged",
          "nutmeg-native": "passed",
          "nutmeg-datafusion": "nonconverged"
        },
        "optimized": {
          "pecan": "passed",
          "nutmeg-native": "passed",
          "nutmeg-datafusion": "passed"
        }
      }
    }
  ]
}
