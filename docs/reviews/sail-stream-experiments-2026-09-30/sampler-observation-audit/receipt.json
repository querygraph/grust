  "source_findings": [
    {
      "reference": "graph_cell.py:471-472",
      "fact": "This controller constructs Sampler with output and watch arguments without overriding interval, so measurement.py default 0.05 seconds applies."
    },
    {
      "reference": "measurement.py:107,136-157,158-182",
      "fact": "Default interval is 0.05 seconds. The loop records scan start, reads process/cgroup data and optionally walks directories, records scan finish, serializes/flushes the row and updates peaks, then calls stop.wait(self.interval). It does not schedule starts on a 50 ms clock."
    },
    {
      "reference": "measurement.py:161-162",
      "fact": "A transition row continues before stop.wait and therefore skips this wait. All unique rows in the captured sample are execute phase, not transition."
    },
    {
      "reference": "measurement.py:136-155",
      "fact": "Reported duration is elapsed Linux monotonic time over the instrumented scan span. The finish timestamp precedes later row aggregation/serialization, file flush, peak bookkeeping and the interval wait."
    },
    {
      "reference": "measurement.py:140-141",
      "fact": "Directory walks are every 20 scans by default, not on a guaranteed one-second schedule."
    }
  ],
  "interpretation_limits": [
    "Sparse tail observations are not the complete sample stream, a random sample, or a full-run latency distribution. Repeated tails are deduplicated; missing observations and truncated leading fragments remain counted.",
    "All 427 retained scans exceeded 50 ms. This sparse observation does not quantify sampler CPU usage, total duty cycle, or perturbation of the graph workload. Elapsed scan spans can include waiting and scheduling.",
    "Neither the range nor a slow row establishes the cause of host pressure or the stream failure. No such causal claim is made.",
    "Sampled memory peaks can miss changes between scans; these observed durations qualify monitoring sensitivity and do not change the pinned current controls."
  ],
