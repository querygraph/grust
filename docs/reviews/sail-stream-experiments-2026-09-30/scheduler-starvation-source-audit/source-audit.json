  "conclusion": {
    "confirmed": "Worker task stream polling and gRPC share primary Tokio runtime; synchronous inner work can delay a poll.",
    "refuted_simplifications": [
      "Substantial preparation runs via spawn_blocking.",
      "Object-store IO has a separate runtime.",
      "Missing displayed CooperativeExec under Parquet does not imply missing cooperation.",
      "An await does not guarantee yielding; budget is not a wall-clock bound."
    ],
    "unproven": "No measured scheduling-delay interval, process/connection attribution or stack establishes scheduler starvation as the cause of any stream loss. Runtime sharing is not a diagnosis.",
    "host_pressure": "Parent reported host macOS paging as an independent confound; guest zero swap/steal and cgroup headroom do not exclude host-induced delays. This audit does not measure or attribute paging.",
    "limits": [
      "Final Linux cooperation rustc cfg not independently extracted.",
      "Configured thread count is not measured process thread inventory.",
      "No per-poll duration at production graph size.",
      "One expensive poll does not establish complete multi-thread-runtime blackout."
    ]
  },
  "control_review": {
    "executed": "Only existing test binary --list discovery; no tests/workload executed for this investigation.",
    "insufficient_existing_controls": [
      "Preparation cancellation/error tests do not exercise long aggregate polls.",
      "Tonic keepalive control intentionally drops PING ACKs; it tests observability, not CPU starvation.",
      "Standalone aggregate allocation probes do not test Tokio scheduling."
    ],
    "proposal_not_run": "Bounded exact-dependency aggregate/join stream, same-runtime heartbeat and independent peer; cooperative and deliberately noncooperative controls with poll-duration/heartbeat measurements. Mechanism plausibility only; parent deferred synthetic controls in favor of existing host/connection evidence."
  },
