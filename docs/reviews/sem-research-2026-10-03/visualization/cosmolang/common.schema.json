{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:querygraph:cosmolang:0.1:common",
  "$defs": {
    "uint": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "context": {
      "type": "object",
      "properties": {
        "graph": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "snapshot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "projection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "hierarchy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "layout": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "selection": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "graph",
        "snapshot",
        "projection",
        "hierarchy",
        "layout",
        "selection"
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "vertex",
            "aggregate",
            "component"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "vertex": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "vertex"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "aggregate": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "aggregate"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "seeds": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ids": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "vertex"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 256
            }
          },
          "required": [
            "ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "selection_handle": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "selection_handle"
          ],
          "additionalProperties": false
        }
      ]
    },
    "resource": {
      "type": "object",
      "properties": {
        "handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "encoded_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "handle",
        "uri",
        "sha256",
        "encoded_bytes",
        "media_type"
      ],
      "additionalProperties": false
    },
    "domain": {
      "enum": [
        "projection",
        "selection",
        "display"
      ]
    }
  }
}
