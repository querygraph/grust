    {
      "name": "ldbc_is1_8796093022220",
      "text": "// IS1. Profile of a person\n/*\n:param personId: 10995116277794\n */\nMATCH (n:Person {id: $personId })-[:IS_LOCATED_IN]->(p:City)\nRETURN\n    n.firstName AS firstName,\n    n.lastName AS lastName,\n    n.birthday AS birthday,\n    n.locationIP AS locationIP,\n    n.browserUsed AS browserUsed,\n    p.id AS cityId,\n    n.gender AS gender,\n    n.creationDate AS creationDate\n",
      "text_sha256": "313fccbebf9ff29880d15514984ddf48d77f921908d1bd42b7b9626bd96479dc",
      "parameters": {
        "personId": 8796093022220
      },
      "expected": [
        [
          "Jose",
          "Alonso",
          558921600000,
          "196.1.135.241",
