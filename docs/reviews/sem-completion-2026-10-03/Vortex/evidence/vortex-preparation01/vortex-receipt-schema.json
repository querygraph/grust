{
  "$defs": {
    "Attempt": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "outcome": {
          "default": "started",
          "enum": [
            "started",
            "completed",
            "error",
            "not_admitted"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "directory": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Directory"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "title": "Attempt",
      "type": "object"
    },
    "Error": {
      "additionalProperties": false,
      "properties": {
        "phase": {
          "title": "Phase",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "phase",
        "type",
        "message"
      ],
      "title": "Error",
      "type": "object"
    },
    "FilePin": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        },
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "title": "FilePin",
      "type": "object"
    },
    "PhysicalCheck": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "directory": {
          "format": "path",
          "title": "Directory",
          "type": "string"
        },
        "rows": {
          "title": "Rows",
          "type": "integer"
        },
        "expected_rows": {
          "title": "Expected Rows",
          "type": "integer"
        },
        "physical_schemas": {
          "items": {
            "type": "string"
