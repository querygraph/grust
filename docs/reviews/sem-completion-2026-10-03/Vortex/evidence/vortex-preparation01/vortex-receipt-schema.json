        "output_root": {
          "format": "path",
          "title": "Output Root",
          "type": "string"
        },
        "binary": {
          "format": "path",
          "title": "Binary",
          "type": "string"
        },
        "venv": {
          "format": "path",
          "title": "Venv",
          "type": "string"
        },
        "python_home": {
          "format": "path",
          "title": "Python Home",
          "type": "string"
        },
        "python_purelib": {
          "format": "path",
