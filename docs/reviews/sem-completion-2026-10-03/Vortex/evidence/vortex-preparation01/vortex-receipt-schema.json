        "runtime_source": {
          "const": "9f0aa7d2a50f1258544d37c05dd19b3ff3d915b3",
          "title": "Runtime Source",
          "type": "string"
        },
        "adapter_source": {
          "const": "4b88c8fb4504ab1d2a896c9e49e4a09df4905bbb",
          "title": "Adapter Source",
          "type": "string"
        },
        "timeout_seconds": {
          "const": 180,
          "default": 180,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "threads": {
          "const": 2,
          "default": 2,
          "title": "Threads",
          "type": "integer"
        },
        "sail_pool_bytes": {
          "const": 536870912,
          "default": 536870912,
          "title": "Sail Pool Bytes",
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "output_root",
        "binary",
        "venv",
        "python_home",
        "python_purelib",
        "python_library_directory",
        "pins",
        "runtime_source",
        "adapter_source"
      ],
      "title": "Plan",
      "type": "object"
    },
