          "default": null,
          "title": "Read Seconds"
        },
        "csr_and_graph_build_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Csr And Graph Build Seconds"
        },
        "algorithm_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Algorithm Seconds"
        },
        "write_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Write Seconds"
        },
        "availability": {
          "default": "unavailable_failed_pipeline",
          "enum": [
            "unavailable_failed_pipeline",
            "observed_materialized_arrow_bridge"
          ],
          "title": "Availability",
          "type": "string"
        },
        "reason": {
          "default": "Separate materialized bridge phases: client Parquet-to-Arrow read; bounded bounded inline Arrow IPC/checkpoint jobs plus stage/projectionStats; all WCC kernels and full Arrow result transport; all client Parquet writes. Not native CSR-only or kernel-only clocks and not the prior native-Parquet profile.",
