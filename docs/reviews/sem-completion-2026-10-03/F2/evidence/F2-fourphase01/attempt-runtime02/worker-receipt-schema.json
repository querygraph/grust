          "minimum": 1,
          "title": "Chunks",
          "type": "integer"
        },
        "checked_ipc_encodings": {
          "default": 0,
          "minimum": 0,
          "title": "Checked Ipc Encodings",
          "type": "integer"
        },
        "create_dataframe_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Create Dataframe Calls",
          "type": "integer"
        },
        "checkpoint_attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Checkpoint Attempts",
          "type": "integer"
        },
        "checkpoints_completed": {
          "default": 0,
          "minimum": 0,
          "title": "Checkpoints Completed",
          "type": "integer"
