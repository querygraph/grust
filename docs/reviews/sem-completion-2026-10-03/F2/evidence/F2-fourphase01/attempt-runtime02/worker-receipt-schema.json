        "encoded_ipc_bytes": {
          "minimum": 0,
          "title": "Encoded Ipc Bytes",
          "type": "integer"
        },
        "balanced_union_depth": {
          "minimum": 0,
          "title": "Balanced Union Depth",
          "type": "integer"
        },
        "cache_threshold_bytes": {
          "const": 67108864,
          "default": 67108864,
          "title": "Cache Threshold Bytes",
          "type": "integer"
        },
        "eager_checkpoints": {
          "const": true,
          "default": true,
          "title": "Eager Checkpoints",
          "type": "boolean"
        },
        "checkpoint_sort_applied": {
          "const": false,
          "default": false,
          "title": "Checkpoint Sort Applied",
          "type": "boolean"
        },
        "completed": {
          "default": false,
          "title": "Completed",
          "type": "boolean"
        }
      },
      "required": [
        "input_name",
        "rows",
        "chunk_rows",
        "chunks",
        "cached_chunks",
        "maximum_ipc_bytes",
        "encoded_ipc_bytes",
        "balanced_union_depth"
      ],
      "title": "ArrowHandoff",
      "type": "object"
    },
    "Error": {
